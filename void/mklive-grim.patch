diff --git a/dracut/vmklive/adduser.sh b/dracut/vmklive/adduser.sh
index 68d94b2..d34fdbd 100644
--- a/dracut/vmklive/adduser.sh
+++ b/dracut/vmklive/adduser.sh
@@ -6,12 +6,12 @@ if ! type getarg >/dev/null 2>&1 && ! type getargbool >/dev/null 2>&1; then
     . /lib/dracut-lib.sh
 fi
 
-echo void-live > ${NEWROOT}/etc/hostname
+echo grimvoid-live > ${NEWROOT}/etc/hostname
 
 USERNAME=$(getarg live.user)
 USERSHELL=$(getarg live.shell)
 
-[ -z "$USERNAME" ] && USERNAME=anon
+[ -z "$USERNAME" ] && USERNAME=grim
 [ -x $NEWROOT/bin/bash -a -z "$USERSHELL" ] && USERSHELL=/bin/bash
 [ -z "$USERSHELL" ] && USERSHELL=/bin/sh
 
@@ -27,9 +27,9 @@ fi
 chroot ${NEWROOT} useradd -m -c $USERNAME -G audio,video,wheel -s $USERSHELL $USERNAME
 chroot ${NEWROOT} passwd -d $USERNAME >/dev/null 2>&1
 
-# Setup default root/user password (voidlinux).
-chroot ${NEWROOT} sh -c 'echo "root:voidlinux" | chpasswd -c SHA512'
-chroot ${NEWROOT} sh -c "echo "$USERNAME:voidlinux" | chpasswd -c SHA512"
+# Setup default root/user password (grim).
+chroot ${NEWROOT} sh -c 'echo "root:grim" | chpasswd -c SHA512'
+chroot ${NEWROOT} sh -c "echo "$USERNAME:grim" | chpasswd -c SHA512"
 
 # Enable sudo permission by default.
 if [ -f ${NEWROOT}/etc/sudoers ]; then
diff --git a/grub/grub_void.cfg.pre b/grub/grub_void.cfg.pre
index dc59be7..f674a60 100644
--- a/grub/grub_void.cfg.pre
+++ b/grub/grub_void.cfg.pre
@@ -30,7 +30,5 @@ default=linux
 timeout=15
 timeout_style=menu
 
-# GRUB init tune for accessibility
-play 600 988 1 1319 4
 
 if [ cpuid -l ]; then
diff --git a/isolinux/isolinux.cfg.in b/isolinux/isolinux.cfg.in
index 6094bd5..e9ac22a 100644
--- a/isolinux/isolinux.cfg.in
+++ b/isolinux/isolinux.cfg.in
@@ -35,6 +35,11 @@ MENU LABEL @@BOOT_TITLE@@ @@KERNVER@@ @@ARCH@@ (graphics disabled)
 KERNEL /boot/vmlinuz
 APPEND initrd=/boot/initrd root=live:CDLABEL=VOID_LIVE init=/sbin/init ro rd.luks=0 rd.md=0 rd.dm=0 loglevel=4 vconsole.unicode=1 vconsole.keymap=@@KEYMAP@@ locale.LANG=@@LOCALE@@ @@BOOT_CMDLINE@@ nomodeset
 
+LABEL linuxlowram
+MENU LABEL @@BOOT_TITLE@@ @@KERNVER@@ @@ARCH@@ - ^Low RAM, no desktop
+KERNEL /boot/vmlinuz
+APPEND initrd=/boot/initrd root=live:CDLABEL=VOID_LIVE init=/sbin/init ro rd.luks=0 rd.md=0 rd.dm=0 loglevel=4 vconsole.unicode=1 vconsole.keymap=@@KEYMAP@@ locale.LANG=@@LOCALE@@ @@BOOT_CMDLINE@@ lowram
+
 LABEL linuxa11y
 MENU LABEL @@BOOT_TITLE@@ @@KERNVER@@ @@ARCH@@ with ^speech
 KERNEL /boot/vmlinuz
diff --git a/mklive.sh b/mklive.sh
index 82ac4c7..157869f 100755
--- a/mklive.sh
+++ b/mklive.sh
@@ -317,6 +317,8 @@ EOF
             "rd.live.ram $BOOT_CMDLINE $cmdline" "$dtb"
         write_entry "${ENTRY_TITLE} (graphics disabled)" "linuxnogfx${id_sfx}" \
             "nomodeset $BOOT_CMDLINE $cmdline" "$dtb"
+        write_entry "${ENTRY_TITLE} - Low RAM, no desktop" "linuxlowram${id_sfx}" \
+            "lowram $BOOT_CMDLINE $cmdline" "$dtb" 'l'
         write_entry "${ENTRY_TITLE} with speech" "linuxa11y${id_sfx}" \
             "live.accessibility live.autologin $BOOT_CMDLINE $cmdline" "$dtb" 's'
         write_entry "${ENTRY_TITLE} with speech (RAM)" "linuxa11yram${id_sfx}" \
@@ -645,6 +647,11 @@ case "$LINUX_VERSION" in
         IGNORE_PKGS+=(linux)
         PACKAGE_LIST+=(linux-asahi linux-base)
         ;;
+    linux-grim)
+        # Grim Void's kernel (Void's 6.18 + BORE); its modules live in <version>-grim
+        IGNORE_PKGS+=(linux)
+        PACKAGE_LIST+=(linux-grim)
+        ;;
     linux)
         PACKAGE_LIST+=(linux)
         LINUX_VERSION="$(XBPS_ARCH=$TARGET_ARCH $XBPS_QUERY_CMD -r "$ROOTFS" ${XBPS_REPOSITORY:=-R} -x linux | grep 'linux[0-9._]\+')"
@@ -657,6 +664,7 @@ shopt -u extglob
 
 _kver="$(XBPS_ARCH=$TARGET_ARCH $XBPS_QUERY_CMD -r "$ROOTFS" ${XBPS_REPOSITORY:=-R} -p pkgver $LINUX_VERSION)"
 KERNELVERSION=$($XBPS_UHELPER_CMD getpkgversion ${_kver})
+[ "$LINUX_VERSION" = linux-grim ] && KERNELVERSION="${KERNELVERSION}-grim"
 
 if [ "$LINUX_VERSION" = linux-asahi ]; then
     KERNELVERSION="${KERNELVERSION%%_*}-asahi_${KERNELVERSION##*_}"

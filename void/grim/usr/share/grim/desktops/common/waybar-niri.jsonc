{
  "layer": "top", "position": "top", "height": 28,
  "modules-left": ["niri/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["memory", "network", "pulseaudio", "battery", "tray"],
  "clock": { "format": "{:%a %d %b  %H:%M}" },
  "memory": { "format": "RAM {used:0.1f}G" },
  "network": { "format-wifi": "{essid}", "format-ethernet": "wired", "format-disconnected": "offline", "on-click": "grim-term -e grim-wifi" },
  "pulseaudio": { "format": "vol {volume}%", "format-muted": "muted" },
  "battery": { "format": "bat {capacity}%" }
}

#!/bin/bash
# grimhelp: Grim Void's help and app centre (a TUI).
#   grimhelp            the menu
#   grimhelp apps       install apps from the list
#   grimhelp settings   quick settings
#   grimhelp search     search Void, Flathub, or build from source
#   grimhelp TOPIC      read a help page (start, apps, desktops, keys, lowram, source, system, spotify)
SHARE=/usr/share/grim
HELP=$SHARE/help
export DIALOGRC=$SHARE/dialogrc
BT="Grim Void 1.2.1"

d() { dialog --backtitle "$BT" "$@" 3>&1 1>&2 2>&3; }
pause() { printf '\n\e[90mPress Enter to go back.\e[0m'; read -r _; }
run() { clear; "$@"; pause; }

# --------------------------------------------------------------- app list
apps_menu() {
    local cats c
    mapfile -t cats < <(grep -v '^#' "$SHARE/apps.list" | cut -d'|' -f1 | awk '!s[$0]++')
    while :; do
        local items=()
        for c in "${cats[@]}"; do items+=("$c" "$(grep -c "^$c|" "$SHARE/apps.list") apps"); done
        c=$(d --title "Install apps" --cancel-label "Back" --menu "Pick a group. Apps marked [Flathub] come from Flathub because they aren't built for musl." 20 70 12 "${items[@]}") || return
        apps_pick "$c"
    done
}

apps_pick() {
    local cat=$1 items=() line name what target tag sel picked=()
    while IFS='|' read -r _ name what target; do
        tag=""; [[ $target == flatpak:* ]] && tag=" [Flathub]"
        local state=off; is_installed "$target" && state=on
        items+=("$name" "$what$tag" "$state")
    done < <(grep "^$cat|" "$SHARE/apps.list")
    sel=$(d --title "$cat" --cancel-label "Back" --separate-output --checklist \
        "Space ticks an app, Enter installs the ticked ones. Unticking an installed app removes it." 22 78 14 "${items[@]}") || return
    local add=() del=()
    while IFS='|' read -r _ name what target; do
        if grep -qxF "$name" <<<"$sel"; then is_installed "$target" || add+=("$target")
        else is_installed "$target" && del+=("$target"); fi
    done < <(grep "^$cat|" "$SHARE/apps.list")
    ((${#add[@]} + ${#del[@]})) || return
    clear
    local t
    for t in "${add[@]}"; do install_target "$t"; done
    for t in "${del[@]}"; do remove_target "$t"; done
    pause
}

is_installed() {
    local t=$1
    case $t in
        void:*) local p; p=${t#void:}; p=${p%% *}; xbps-query "$p" >/dev/null 2>&1 ;;
        flatpak:*) command -v flatpak >/dev/null && flatpak info "${t#flatpak:}" >/dev/null 2>&1 ;;
    esac
}
install_target() {
    case $1 in
        void:*) # shellcheck disable=SC2086
                sudo env GRIM_HELP=1 grimctl install ${1#void:} ;;
        flatpak:*) sudo grimctl install "@flatpak:${1#flatpak:}" ;;
    esac
}
remove_target() {
    case $1 in
        void:*) # shellcheck disable=SC2086
                sudo grimctl remove ${1#void:} ;;
        flatpak:*) sudo grimctl remove "@flatpak:${1#flatpak:}" ;;
    esac
}

# --------------------------------------------------------------- search
search_menu() {
    local q items=() line pick
    q=$(d --title "Search" --inputbox "What are you looking for? (a name or a word like 'pdf' or 'music')" 9 64) || return
    [[ -z $q ]] && return
    dialog --backtitle "$BT" --infobox "Searching Void and Flathub for \"$q\"..." 5 60
    while IFS= read -r line; do
        local name desc; name=$(sed -E 's/^\[.\] //; s/-[^-]+_[0-9]+ .*//' <<<"$line"); desc=$(sed -E 's/^\[.\] [^ ]+ +//' <<<"$line")
        [[ -n $name ]] && items+=("void:$name" "${desc:0:58}")
    done < <(xbps-query -Rs "$q" 2>/dev/null | head -60)
    if command -v flatpak >/dev/null; then
        while IFS=$'\t' read -r id name; do
            [[ -n $id && $id == *.* ]] && items+=("flatpak:$id" "[Flathub] ${name:0:48}")
        done < <(flatpak search --columns=application,name "$q" 2>/dev/null | head -25)
    fi
    items+=("git:" "Build something from a git link (any project) ...")
    ((${#items[@]} > 2)) || { d --msgbox "Nothing found for \"$q\"." 6 50; return; }
    pick=$(d --title "Results for \"$q\"" --cancel-label "Back" --menu "Pick one:" 22 80 15 "${items[@]}") || return
    case $pick in
        void:*)
            local name=${pick#void:} how
            how=$(d --title "$name" --menu "How should $name be installed?" 12 72 3 \
                1 "Ready-made package (fast)" \
                2 "Compile from source on this PC (-march=native, slower)" \
                3 "Show its details") || return
            case $how in
                1) run sudo env GRIM_HELP=1 grimctl install "$name" ;;
                2) run sudo grimctl build "$name" ;;
                3) run xbps-query -R "$name" ;;
            esac ;;
        flatpak:*) run sudo grimctl install "@flatpak:${pick#flatpak:}" ;;
        git:) build_git ;;
    esac
}

build_git() {
    local url
    url=$(d --title "Build from a git link" --inputbox \
        "Paste a git link (GitHub, GitLab, Codeberg...). Grim works out how to build it (meson, cmake, cargo, go, make), compiles it for your CPU and installs it as a package you can update and remove." 12 74) || return
    [[ -n $url ]] && run sudo grimctl build "$url"
}

remove_menu() {
    local items=() p sel
    while read -r p; do [[ -n $p ]] && items+=("$p" "" off); done < <(grimctl get packages)
    ((${#items[@]})) || { d --msgbox "No apps in the system file yet." 6 46; return; }
    sel=$(d --title "Remove apps" --separate-output --checklist "Tick the apps to remove:" 20 70 12 "${items[@]}") || return
    [[ -n $sel ]] && { mapfile -t sel <<<"$sel"; run sudo grimctl remove "${sel[@]}"; }
}

# --------------------------------------------------------------- settings
wallpaper_menu() {
    local items=() f pick
    for f in /usr/share/grim/wallpapers/* "$HOME"/Pictures/*.{png,jpg,jpeg,webp}; do [[ -f $f ]] && items+=("$f" ""); done
    items+=("other" "type a path...")
    pick=$(d --title "Wallpaper" --menu "Now: $(grimctl wallpaper)\n\nOr from a terminal: grimctl wallpaper set FILE" 20 76 10 "${items[@]}") || return
    [[ $pick == other ]] && { pick=$(d --inputbox "Path to the picture:" 8 70 "$HOME/") || return; }
    clear; grimctl wallpaper set "$pick"; pause
}

desktop_menu() {
    local now pick
    now=$(grimctl get desktop)
    pick=$(d --title "Desktop at login" --default-item "${now:-icewm}" --menu "What starts when you log in on tty1? (now: ${now:-none})" 16 64 8 \
        icewm "IceWM: light, with a taskbar" niri "Niri: scrolling tiling (Wayland)" openbox "Openbox: floating" \
        i3 "i3: tiling" dwm "dwm: tiny tiling" river "river: tiling (Wayland)" ask "ask every time" none "just the terminal") || return
    case $pick in icewm|niri|openbox|i3|dwm|river)
        command -v "$pick" >/dev/null || { clear; sudo grimctl install "$pick" $( [[ $pick == niri || $pick == river ]] && echo "Waybar mako swaybg fuzzel" ); }
    esac
    clear
    sudo sed -i -E "s/^desktop *=[^#]*/desktop = $pick   /" /etc/grim/system.conf && echo "Desktop at login: $pick"; pause
}

lowram_menu() {
    local c
    c=$(d --title "Low-RAM mode" --menu "A console with nothing else running: no desktop, network or services.\nThe boot menu also has a 'Low RAM' entry." 14 72 4 \
        1 "Switch to low-RAM mode now" 2 "Back to the full system now" \
        3 "Always start in low-RAM mode" 4 "Start normally (desktop)") || return
    clear
    case $c in 1) grimctl mode lowram ;; 2) grimctl mode desktop ;; 3) sudo grimctl boot lowram ;; 4) sudo grimctl boot desktop ;; esac
    pause
}

fetch_menu() {
    local c
    c=$(d --title "grimfetch" --menu "Which logo should grimfetch show?" 11 60 2 void "the Grim Void ring" reaper "the Grim OS reaper") || return
    clear; grimctl fetch logo "$c"; grimfetch --logo "$c"; pause
}

help_menu() {
    local items=() f pick
    for f in "$HELP"/*.txt; do items+=("$(basename "$f" .txt)" "$(head -1 "$f")"); done
    while pick=$(d --title "Help" --cancel-label "Back" --menu "Pick a page:" 18 70 10 "${items[@]}"); do
        d --title "$pick" --exit-label "Back" --textbox "$HELP/$pick.txt" 30 90
    done
}

# --------------------------------------------------------------- quick settings
qs_now() {   # the current value of each quick setting, for the menu
    case $1 in
        wifi) nmcli radio wifi 2>/dev/null | sed 's/enabled/on/; s/disabled/off/' ;;
        bt) if command -v bluetoothctl >/dev/null && [[ -e /var/service/bluetoothd ]]; then
                bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && echo on || echo off
            else echo "not set up"; fi ;;
        vol) wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{v=int($2*100+0.5); print v "%" ($3 ? " (muted)" : "")}' ;;
        light) command -v brightnessctl >/dev/null && brightnessctl -m -c backlight 2>/dev/null | cut -d, -f4 | head -1 ;;
        dnd) if command -v dunstctl >/dev/null && pgrep -x dunst >/dev/null; then dunstctl is-paused | sed 's/true/on/; s/false/off/'
             elif command -v makoctl >/dev/null && pgrep -x mako >/dev/null; then makoctl mode | grep -q do-not-disturb && echo on || echo off
             else echo off; fi ;;
        night) pgrep -x gammastep >/dev/null && echo on || echo off ;;
        mic) wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | grep -q MUTED && echo muted || echo on ;;
        out) wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null | sed -n 's/.*node.description = "\(.*\)"/\1/p' | head -1 ;;
        browser) xdg-settings get default-web-browser 2>/dev/null | sed 's/\.desktop$//' ;;
        shell) basename "$(getent passwd "$USER" | cut -d: -f7)" ;;
        cpu) v=$(grimctl get cpu); echo "${v:-balanced}" ;;
        *) grimctl get "$1" ;;
    esac
}

qs_menu() {
    local c bat=""
    ls /sys/class/power_supply/BAT*/charge_control_end_threshold >/dev/null 2>&1 && bat=1
    while :; do
        local items=(
            wifi    "Wi-Fi                 $(qs_now wifi)"
            bt      "Bluetooth             $(qs_now bt)"
            vol     "Volume                $(qs_now vol)"
            light   "Screen brightness     $(qs_now light)"
            dnd     "Do not disturb        $(qs_now dnd)"
            night   "Night light           $(qs_now night)"
            dns     "DNS                   $(awk '/^nameserver/{print $2; exit}' /etc/resolv.conf)"
            mic     "Microphone            $(qs_now mic)"
            out     "Sound output          $(qs_now out)"
            cpu     "Power mode            $(qs_now cpu)"
        )
        if [[ -n $bat ]]; then local lim; lim=$(qs_now battery_limit); items+=(battery "Battery charge limit  ${lim:+$lim%}${lim:-none}"); fi
        items+=(
            update  "Automatic updates     $(qs_now auto_update)"
            zram    "Compressed RAM swap   $(qs_now zram)"
            boot    "Start in              $(qs_now boot)"
            desktop "Desktop at login      $(qs_now desktop)"
            keymap  "Keyboard layout       $(qs_now keymap)"
            tz      "Time zone             $(qs_now timezone)"
            browser "Default browser       $(qs_now browser)"
            login   "Log in automatically  $(v=$(qs_now autologin); echo "${v:-off}")"
            shell   "Your shell            $(qs_now shell)"
            host    "Computer name         $(cat /etc/hostname 2>/dev/null)"
            wall    "Wallpaper"
            logo    "grimfetch logo"
            dock    "Taskbar look (IceWM)"
        )
        c=$(d --title "Quick settings" --cancel-label "Back" --no-tags --menu "Pick one to change it." 30 66 24 "${items[@]}") || return
        case $c in
            wifi)  if [[ $(qs_now wifi) == on ]]; then nmcli radio wifi off; else nmcli radio wifi on; fi ;;
            bt)    if [[ $(qs_now bt) == "not set up" ]]; then
                       clear; sudo grimctl install bluez && sudo ln -sf /etc/sv/bluetoothd /var/service/ && sleep 2
                   fi
                   if [[ $(qs_now bt) == on ]]; then bluetoothctl power off >/dev/null; else bluetoothctl power on >/dev/null; fi ;;
            vol)   local v; v=$(qs_now vol); v=${v%%%*}
                   v=$(d --title "Volume" --rangebox "Left/Right or type a number. 0 mutes." 7 50 0 150 "${v:-50}") || continue
                   if ((v == 0)); then wpctl set-mute @DEFAULT_AUDIO_SINK@ 1; else wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume @DEFAULT_AUDIO_SINK@ "$v%"; fi ;;
            light) local b; b=$(qs_now light); b=${b%\%}
                   b=$(d --title "Screen brightness" --rangebox "Left/Right or type a number." 7 50 5 100 "${b:-80}") || continue
                   brightnessctl -c backlight set "$b%" >/dev/null ;;
            dnd)   if command -v dunstctl >/dev/null && pgrep -x dunst >/dev/null; then dunstctl set-paused toggle
                   elif command -v makoctl >/dev/null; then makoctl mode -t do-not-disturb >/dev/null; fi ;;
            night) if pgrep -x gammastep >/dev/null; then pkill -x gammastep
                   else
                       command -v gammastep >/dev/null || { clear; sudo grimctl install gammastep; }
                       local t; t=$(d --title "Night light" --menu "How warm?" 12 50 4 4500 "a little" 3800 "warm" 3200 "very warm" 2600 "candle") || continue
                       (setsid gammastep -O "$t" >/dev/null 2>&1 &)
                   fi ;;
            dns)   local n; n=$(d --title "DNS" --menu "Which DNS servers?" 13 64 4 auto "from your router (default)" cloudflare "Cloudflare 1.1.1.1 (fast)" \
                       quad9 "Quad9 (blocks known bad sites)" adguard "AdGuard (blocks ads)") || continue
                   clear; sudo grimctl net dns "$n"; pause ;;
            battery) local l; l=$(d --title "Battery charge limit" --menu "Stopping a little early makes the battery last more years." 12 60 4 \
                       80 "stop at 80% (best for the battery)" 90 "stop at 90%" 100 "charge to 100%") || continue
                   clear; sudo grimctl battery limit "$l"; pause ;;
            update) local u; u=$(d --title "Automatic updates" --default-item "$(qs_now auto_update)" --menu "grimctl update runs by itself:" 11 50 3 \
                       daily "once a day" weekly "once a week" off "never (run it yourself)") || continue
                   clear; sudo grimctl set auto_update "$u"; pause ;;
            zram)  local z; z=$(d --title "Compressed RAM swap (zram)" --default-item "$(qs_now zram)" --menu "How much RAM can be used as compressed swap?" 13 60 5 \
                       25% "a quarter" 50% "half (default)" 75% "three quarters (low-RAM PCs)" 100% "as much as RAM" off "off") || continue
                   clear; sudo grimctl set zram "$z"; pause ;;
            boot)  local m; m=$(d --title "Start in" --menu "What should Grim Void start in?" 10 64 2 desktop "the desktop after login" lowram "low-RAM mode: a console only") || continue
                   clear; sudo grimctl boot "$m"; pause ;;
            desktop) desktop_menu ;;
            keymap) local k; k=$(d --title "Keyboard layout" --default-item "$(qs_now keymap)" --menu "Layout:" 18 50 10 \
                       us US uk UK de German fr French es Spanish it Italian se Swedish no Norwegian pl Polish br-abnt2 Brazilian) || continue
                   clear; sudo grimctl set keymap "$k"; loadkeys "$k" 2>/dev/null
                   [[ -n ${DISPLAY:-} ]] && setxkbmap "${k%%-*}" 2>/dev/null; pause ;;
            tz)    local z2; z2=$(d --title "Time zone" --inputbox "Like Europe/London, America/New_York, Asia/Tokyo:" 9 60 "$(qs_now timezone)") || continue
                   [[ -f /usr/share/zoneinfo/$z2 ]] || { d --msgbox "No time zone called $z2." 6 50; continue; }
                   clear; sudo grimctl set timezone "$z2"; pause ;;
            mic)   wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
            out)   local -a sinks=(); local id name
                   while read -r id name; do sinks+=("$id" "$name"); done < <(wpctl status 2>/dev/null |
                       awk '/Sinks:/{f=1; next} f && /^ *│ *$|Sources:/{f=0} f' | sed -E 's/[│*]//g; s/\[vol:.*//' | awk 'NF {id=$1; sub(/\.$/, "", id); $1=""; sub(/^ /, ""); print id, $0}')
                   ((${#sinks[@]})) || { d --msgbox "No sound outputs found (is PipeWire running?)." 6 54; continue; }
                   id=$(d --title "Sound output" --menu "Where should sound play?" 16 70 8 "${sinks[@]}") || continue
                   wpctl set-default "$id" ;;
            cpu)   local m; m=$(d --title "Power mode" --default-item "$(qs_now cpu)" --menu "How hard should the CPU work?" 12 64 3 \
                       performance "full speed (games, builds; more heat and battery use)" \
                       balanced "speeds up when needed (default)" \
                       powersave "slow and cool (longest battery)") || continue
                   clear; sudo grimctl set cpu "$m"; pause ;;
            browser) local -a bs=(); local f
                   for f in grim-browser firefox chromium org.chromium.Chromium com.brave.Browser qutebrowser io.gitlab.librewolf-community; do
                       ls /usr/share/applications/$f.desktop /var/lib/flatpak/exports/share/applications/$f.desktop 2>/dev/null | grep -q . && bs+=("$f" "")
                   done
                   ((${#bs[@]})) || { d --msgbox "No browsers found." 6 40; continue; }
                   f=$(d --title "Default browser" --menu "Links open in:" 14 60 7 "${bs[@]}") || continue
                   xdg-settings set default-web-browser "$f.desktop" 2>/dev/null; xdg-mime default "$f.desktop" x-scheme-handler/http x-scheme-handler/https text/html ;;
            login) local l; l=$(d --title "Log in automatically" --menu "Skip the password on tty1? (Anyone at the PC gets in: only for a PC at home.)" 12 66 2 \
                       "$USER" "yes, log $USER in automatically" off "no, ask for the password") || continue
                   clear; sudo grimctl set autologin "$l"; pause ;;
            shell) local -a sh=(); local x
                   for x in bash fish zsh dash; do command -v $x >/dev/null && sh+=("$(command -v $x)" "$x"); done
                   x=$(d --title "Your shell" --menu "The shell your terminals and logins use:" 13 50 4 "${sh[@]}") || continue
                   clear; sudo chsh -s "$x" "$USER" && echo "Your shell is now $(basename "$x") (from your next login)."; pause ;;
            host)  local h; h=$(d --title "Computer name" --inputbox "Letters, numbers and - only:" 8 50 "$(cat /etc/hostname 2>/dev/null)") || continue
                   [[ $h =~ ^[a-zA-Z0-9-]{1,63}$ ]] || { d --msgbox "Letters, numbers and - only." 6 40; continue; }
                   clear; sudo grimctl set hostname "$h"; pause ;;
            dock)  if command -v grim-dock >/dev/null; then grim-dock
                   elif d --yesno "The taskbar is changed with grim-dock, which isn't installed yet.\n\nInstall it now?" 9 60; then
                       clear; sudo env GRIM_HELP=1 grimctl install grim-dock && grim-dock
                   fi ;;
            wall)  wallpaper_menu ;;
            logo)  fetch_menu ;;
        esac
    done
}

main_menu() {
    local c
    while :; do
        c=$(d --title "grimhelp" --cancel-label "Exit" --menu "Help and apps for Grim Void." 22 66 13 \
            0 "Quick settings (Wi-Fi, sound, brightness, updates...)" \
            1 "Install apps" \
            2 "Search for anything (Void, Flathub, source)" \
            3 "Build something from a git link" \
            4 "Remove apps" \
            5 "Update everything" \
            6 "Wi-Fi" \
            7 "Wallpaper" \
            8 "Desktop at login" \
            9 "Low-RAM mode" \
            10 "grimfetch logo" \
            11 "Edit the system file (/etc/grim/system.conf)" \
            12 "Help pages") || { clear; exit 0; }
        case $c in
            0) qs_menu ;; 1) apps_menu ;; 2) search_menu ;; 3) build_git ;; 4) remove_menu ;;
            5) run sudo grimctl update ;; 6) run grim-wifi ;; 7) wallpaper_menu ;; 8) desktop_menu ;;
            9) lowram_menu ;; 10) fetch_menu ;; 11) clear; sudo grimctl edit; pause ;; 12) help_menu ;;
        esac
    done
}

case ${1:-} in
    "") main_menu ;;
    apps|install) apps_menu; clear ;;
    settings|quick|qs) qs_menu; clear ;;
    search) search_menu; clear ;;
    -h|--help) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) [[ -f $HELP/$1.txt ]] && { cat "$HELP/$1.txt"; exit; }
       echo "No help page called $1. Pages: $(cd "$HELP" && ls | sed 's/\.txt$//' | tr '\n' ' ')"; exit 1 ;;
esac

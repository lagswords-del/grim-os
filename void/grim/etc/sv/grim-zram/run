#!/bin/sh
# Grim Void: compressed swap in RAM (zram). Size from "zram =" in /etc/grim/system.conf.
exec 2>&1
want=$(grimctl get zram 2>/dev/null); want=${want:-50%}
[ "$want" = off ] && exec sv down grim-zram
total=$(awk '/MemTotal/{print $2 * 1024}' /proc/meminfo)
case $want in
    *%) size=$(( total * ${want%\%} / 100 )) ;;
    *)  size=$want ;;
esac
if ! grep -q '^/dev/zram0' /proc/swaps; then
    modprobe zram num_devices=1 || exit 1
    [ -e /sys/block/zram0 ] || exit 1
    echo 1 > /sys/block/zram0/reset 2>/dev/null
    # zstd packs best; lz4 is the fallback on kernels without it
    echo zstd > /sys/block/zram0/comp_algorithm 2>/dev/null || echo lz4 > /sys/block/zram0/comp_algorithm
    echo "$size" > /sys/block/zram0/disksize
    mkswap -L zram0 /dev/zram0 >/dev/null && swapon -p 100 /dev/zram0
    logger -t grim-zram "zram: $(( size / 1048576 )) MB ($want of RAM)" 2>/dev/null
fi
# also at boot: the battery charge limit from "battery_limit =" (grimctl battery limit N)
lim=$(grimctl get battery_limit 2>/dev/null)
for b in /sys/class/power_supply/BAT*/charge_control_end_threshold; do [ -n "$lim" ] && [ -w "$b" ] && echo "$lim" > "$b"; done
# and the CPU power mode ("cpu =" performance, balanced or powersave)
cpu=$(grimctl get cpu 2>/dev/null)
case $cpu in performance) gov=performance ;; powersave) gov=powersave ;; balanced) gov=schedutil ;; *) gov= ;; esac
[ -n "$gov" ] && for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo "$gov" > "$g" 2>/dev/null; done
exec sleep infinity

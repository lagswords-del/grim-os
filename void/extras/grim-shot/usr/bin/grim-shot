#!/bin/bash
# grim-shot: screenshots and screen recordings for every Grim Void desktop (X11 and Wayland).
#   grim-shot              a menu (Super+Shift+S)
#   grim-shot area         drag a box          grim-shot window   the window you click
#   grim-shot full         the whole screen    grim-shot delay N  the whole screen after N seconds
#   grim-shot record       record the screen (area or full); run again or "grim-shot stop" to stop
#   grim-shot gif          record a short GIF
#   grim-shot last         open the last picture      grim-shot folder   open the folder
# Pictures go to ~/Pictures/Screenshots and are copied to the clipboard.
set -uo pipefail
DIR=${GRIM_SHOT_DIR:-$HOME/Pictures/Screenshots}
STATE=${XDG_RUNTIME_DIR:-/tmp}/grim-shot
mkdir -p "$DIR" "$STATE"
WAYLAND=no; [[ -n ${WAYLAND_DISPLAY:-} ]] && WAYLAND=yes
stamp() { date +%Y-%m-%d_%H-%M-%S; }
note() { command -v notify-send >/dev/null && notify-send -a "Grim Shot" -i camera-photo "$1" "${2:-}"; echo "$1 ${2:-}"; }

copy_image() {
    if [[ $WAYLAND == yes ]]; then wl-copy --type image/png < "$1"; else xclip -selection clipboard -t image/png -i "$1"; fi
}

# take KIND: area | window | full
take() {
    local kind=$1 out="$DIR/shot-$(stamp).png" geo
    if [[ $WAYLAND == yes ]]; then
        case $kind in
            area)   geo=$(slurp) || return 1; grim -g "$geo" "$out" ;;
            window) note "Drag around the window"; geo=$(slurp) || return 1; grim -g "$geo" "$out" ;;
            full)   grim "$out" ;;
        esac
    else
        case $kind in
            area)   maim -s -u "$out" || return 1 ;;
            window) maim -u -i "$(xdotool selectwindow)" "$out" || return 1 ;;
            full)   maim -u "$out" ;;
        esac
    fi
    [[ -s $out ]] || { note "Screenshot cancelled"; return 1; }
    copy_image "$out"
    echo "$out" > "$STATE/last"
    note "Screenshot saved" "$(basename "$out") - also copied, paste it anywhere"
}

recording() { [[ -f $STATE/rec.pid ]] && kill -0 "$(cat "$STATE/rec.pid")" 2>/dev/null; }

record() {   # record [gif]
    if recording; then stop; return; fi
    local mode=${1:-video} out geo size off
    out="$DIR/rec-$(stamp).mp4"
    local how; how=$(pick "Record what?" "area" "full screen") || return 1
    if [[ $WAYLAND == yes ]]; then
        local args=(-f "$out"); [[ $how == area ]] && { geo=$(slurp) || return 1; args+=(-g "$geo"); }
        setsid wf-recorder "${args[@]}" >/dev/null 2>&1 &
    else
        if [[ $how == area ]]; then
            read -r size off < <(slop -f "%wx%h +%x,%y") || return 1
        else
            size=$(xdotool getdisplaygeometry | tr ' ' x)
            off="+0,0"
        fi
        setsid ffmpeg -loglevel error -y -f x11grab -framerate 30 -video_size "$size" -i "${DISPLAY}${off}" \
            -c:v libx264 -preset veryfast -pix_fmt yuv420p "$out" >/dev/null 2>&1 &
    fi
    echo $! > "$STATE/rec.pid"; echo "$out" > "$STATE/rec.file"; echo "$mode" > "$STATE/rec.mode"
    note "Recording" "run grim-shot again (or Super+Shift+S) to stop"
}

stop() {
    recording || { note "Nothing is recording"; return 1; }
    kill -INT "$(cat "$STATE/rec.pid")"; local i; for i in $(seq 1 20); do recording || break; sleep 0.25; done
    local out mode; out=$(cat "$STATE/rec.file"); mode=$(cat "$STATE/rec.mode")
    rm -f "$STATE/rec.pid"
    if [[ $mode == gif ]]; then
        local gif=${out%.mp4}.gif
        ffmpeg -loglevel error -y -i "$out" -vf "fps=15,scale=800:-1:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse" "$gif" && rm -f "$out" && out=$gif
    fi
    echo "$out" > "$STATE/last"
    note "Recording saved" "$(basename "$out")"
}

# pick "question" choice... -> the chosen text (rofi on X11, fuzzel on Wayland, numbers in a terminal)
pick() {
    local q=$1; shift
    if [[ -t 0 && -t 1 ]]; then
        local i; for i in $(seq 1 $#); do printf '  \e[31m%d\e[0m  %s\n' "$i" "${!i}"; done
        read -rp "$q " n; [[ $n =~ ^[0-9]+$ ]] && ((n >= 1 && n <= $#)) && { echo "${!n}"; return 0; }; return 1
    elif [[ $WAYLAND == yes ]] && command -v fuzzel >/dev/null; then printf '%s\n' "$@" | fuzzel --dmenu -p "$q " -l $#
    elif command -v rofi >/dev/null; then printf '%s\n' "$@" | rofi -dmenu -p "$q" -l $#
    else printf '%s\n' "$@" | dmenu -p "$q"; fi
}

menu() {
    local rec="Record the screen"; recording && rec="Stop recording"
    local c; c=$(pick "Grim Shot" "Area (drag a box)" "Window" "Full screen" "Full screen in 5 seconds" "$rec" "Record a GIF" "Open the last one" "Open the folder") || exit 0
    case $c in
        Area*) take area ;; Window) take window ;; "Full screen") take full ;;
        *5\ seconds) sleep 5; take full ;; "Record the screen") record ;; "Stop recording") stop ;;
        "Record a GIF") record gif ;; "Open the last one") open_last ;; "Open the folder") xdg-open "$DIR" ;;
    esac
}

open_last() { local f; f=$(cat "$STATE/last" 2>/dev/null) && [[ -f $f ]] && xdg-open "$f" || note "No screenshot yet"; }

case ${1:-menu} in
    menu) menu ;;
    area|window|full) take "$1" ;;
    delay) sleep "${2:-5}"; take full ;;
    record|rec) record ;;
    gif) record gif ;;
    stop) stop ;;
    last) open_last ;;
    folder) xdg-open "$DIR" ;;
    -h|--help|help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) echo "unknown: $1 (grim-shot help)" >&2; exit 1 ;;
esac

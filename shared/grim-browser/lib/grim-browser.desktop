[Desktop Entry]
Type=Application
Name=Grim Browser
GenericName=Web Browser
Comment=Private browsing: no telemetry, ads and trackers blocked, private windows through Tor
Exec=grim-browser %u
Icon=grim-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=grim-browser
Actions=private;burn-profile;

[Desktop Action private]
Name=New private window (through Tor)
Exec=grim-browser --private

[Desktop Action burn-profile]
Name=Start over with a fresh profile
Exec=grim-term -e grim-browser --reset

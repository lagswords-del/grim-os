    "fullscreen": "Fullscreen", "maximize": "Maximize the column", "overview": "Overview of all windows",
    "settings": "Grim DE Settings", "lock": "Lock the screen", "power": "Power menu", "screenshot": "Screenshot (drag an area)",
    "game_mode": "Game mode on/off", "files": "File manager", "hide": "Hide the window into the dock",
}
BAR_LAYOUTS = [("strip", "Full strip (Classic, Graphite Icons)"), ("floating", "Floating glass (Frost Glass)"),
               ("pills", "Three pills (Reaper Pills, Nord Pills)"), ("island", "Island (Red Island)"),
               ("minimal", "Minimal (CachyOS Minimal)"), ("win7", "Windows 7 taskbar (apps in the bar, no dock)")]
DOCK_LAYOUTS = [("pill", "Floating pill"), ("outlined", "Pill with an accent outline"),
                ("panel", "Full-width panel"), ("minimal", "Icons only, no background"), ("win7", "Windows 7 glass")]
DOCK_POSITIONS = [("bottom", "Bottom"), ("left", "Left"), ("right", "Right"), ("top", "Top")]
WS_STYLES = [("dots", "Dots"), ("numbers", "Numbers")]
DOCK_ITEMS = [("apps", "Apps", "Pinned and open apps. Click an open app to hide it, click again to bring it back."),
              ("launcher", "App finder button", "The Grim logo; opens the app finder"),

#!/usr/bin/env python3
"""Grim DE Settings (grim-de-settings [page]): the settings app for the Grim desktop (niri + Grim Shell).
Categories on the left, settings on the right. Every change goes through `grim-de set`,
which rewrites the config and reloads niri and the shell live."""
import json, os, shutil, subprocess, sys, threading
from pathlib import Path

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

GRIM_DE = os.environ.get("GRIM_DE_BIN", "grim-de")
GRIM_SHARE = Path(os.environ.get("GRIM_SHARE", "/usr/share/grimos"))


MODULES = [("workspaces", "Workspaces"), ("title", "Window title"), ("date", "Date"), ("clock", "Time"), ("tray", "App tray"),
           ("updates", "Update notifier"),
           ("volume", "Volume"), ("network", "Network"), ("battery", "Battery"),

#!/bin/sh
# grim-shot: press PrtScreen, drag over an area. Saved to ~/Pictures/Screenshots and copied.
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"
if [ -n "$WAYLAND_DISPLAY" ]; then
    command -v slurp >/dev/null || { notify-send "Screenshot" "Install the screenshot tool from grimhelp first."; exit 1; }
    area=$(slurp -d -b 00000066 -c ffffffcc -w 2) || exit 0
    grim -g "$area" "$file" || exit 1
    wl-copy --type image/png < "$file"
else
    command -v maim >/dev/null || { notify-send "Screenshot" "Install the screenshot tool from grimhelp first."; exit 1; }
    maim --select --hidecursor --bordersize=2 --color=1,1,1,0.8 "$file" || exit 0
    xclip -selection clipboard -t image/png -i "$file"
fi
notify-send -i "$file" "Screenshot saved" "Copied to the clipboard. $file"

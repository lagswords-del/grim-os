#!/usr/bin/env python3
"""grim-rice: Grim OS rices for every desktop.

  grim-rice list                         rices and which one is in use
  grim-rice current                      id of the rice in use
  grim-rice desktops                     installed desktops (and the one running)
  grim-rice apply <id> [--desktop D | --all] [--no-reload]
  grim-rice dock on|off                  show or hide the dock, then re-apply
  grim-rice bar top|bottom               move the bar, then re-apply
  grim-rice session <desktop>            started at login: wallpaper, bar, dock, notifications

A rice (/usr/share/grimos/rices/<id>.json) is a palette, font, wallpaper and a few
layout numbers. This script turns it into each desktop's own config files, with the
same keys everywhere:
  Super+T      toggle floating (maximize on floating-only desktops)
  Super+Q      close window
  Super+Space  app finder
  Super+Return terminal          Super+F1  Grim Settings
  Print        screenshot: drag an area
  Super+left-drag move a window, Super+right-drag resize it
"""
import json, os, re, shutil, subprocess, sys
from pathlib import Path

SHARE = Path(os.environ.get("GRIM_SHARE", "/usr/share/grimos"))
RICES = SHARE / "rices"
WALLS = SHARE / "wallpapers"
HOME = Path.home()
CFG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
STATE = CFG / "grimos" / "rice.json"
GEN = CFG / "grimos"          # generated bar/compositor/notification configs live here

DESKTOPS = {  # id: (binary that proves it is installed, display name, kind)
    "i3": ("i3", "i3", "x11-wm"),
    "openbox": ("openbox", "Openbox", "x11-wm"),
    "icewm": ("icewm", "IceWM", "x11-wm"),
    "xfce": ("xfce4-session", "XFCE", "de"),
    "sway": ("sway", "Sway", "wl-wm"),
    "hyprland": ("Hyprland", "Hyprland", "wl-wm"),
    "niri": ("niri", "Niri", "wl-wm"),
    "gnome": ("gnome-shell", "GNOME", "de"),
    "kde": ("plasmashell", "KDE Plasma", "de"),
    "cosmic": ("cosmic-comp", "COSMIC", "de"),
}

# Nerd Font glyphs used by the bars
IC = {"vol": "", "mute": "", "kbd": "", "wifi": "", "eth": "",
      "disk": "", "temp": "", "mem": "", "bat": "", "chg": "",
      "power": "", "dot": "", "ring": "",
      "skull": "\U000f068c", "sun": "\uf185", "wifi_off": "\U000f092e", "gear": "\uf013",
      "bell": "\uf0f3", "bell_off": "\uf1f6", "update": "\uf021", "gauge": "\uf0e4",
      "bat0": "\uf244", "bat1": "\uf243", "bat2": "\uf242", "bat3": "\uf241"}


# ------------------------------------------------------------------ helpers
USER_RICES = CFG / "grimos" / "rices"     # rices saved from Grim Settings

BAR_STYLES = {  # id: (name, description)
    "classic": ("Classic", "Full-width strip: date block, IP, disk, temperature. The Nord Snow bar."),
    "reaper-pills": ("Reaper Pills", "Three floating pills, a reaper launcher and dot workspaces."),
    "red-island": ("Red Island", "Everything in one centred floating island."),
    "nord-pills": ("Nord Pills", "Three floating pills with numbered workspaces."),
    "frost-glass": ("Frost Glass", "A see-through floating bar with a thin accent outline."),
    "graphite-icons": ("Graphite Icons", "Full strip, icons only, dot workspaces."),
    "cachyos-minimal": ("CachyOS Minimal", "Launcher, workspace pill, bold clock, icons only."),
}
BAR_MODULES = ["volume", "network", "battery", "cpu", "memory", "updates", "tray", "power"]
DEFAULT_MODULES = ["volume", "network", "battery", "updates", "tray", "power"]
SETTABLE = {"bar_style", "bar_height", "bar_modules", "clock24", "bar_position", "dock", "dock_position",
            "dock_size", "dock_autohide", "wallpaper", "wallpaper_mode", "colors", "terminal"}


def rice_path(rid):
    for d in (USER_RICES, RICES):
        if (d / f"{rid}.json").exists():
            return d / f"{rid}.json"
    return None


def load_rice(rid):
    """The rice, with everything changed in Grim Settings layered on top."""
    p = rice_path(rid)
    if not p:
        sys.exit(f"grim-rice: no rice called '{rid}'. Try: grim-rice list")
    r = json.loads(p.read_text())
    r["id"] = rid
    st = state()
    for k in ("dock", "bar_position"):
        if st.get(k) is not None:
            r[k] = st[k]
    r["colors"] = {**r["colors"], **(st.get("colors") or {})}
    wall = st.get("wallpaper") or str(WALLS / r["wallpaper"])
    r["wall"] = wall if os.path.exists(wall) else str(WALLS / r["wallpaper"])
    r["wall_mode"] = st.get("wallpaper_mode", "fill")
    t = {"font": r["font"], "size": r["font_size"], "opacity": 1.0, "padding": 12, "fetch": False}
    t.update(st.get("terminal") or {})
    r["term"] = t
    r["bar_style"] = st.get("bar_style") or r.get("bar_style")    # None = per desktop default
    r["bar_height"] = int(st.get("bar_height") or 28)
    r["bar_modules"] = st.get("bar_modules") or DEFAULT_MODULES
    r["clock24"] = st.get("clock24", True)
    r["dock_position"] = st.get("dock_position", "bottom")
    r["dock_size"] = int(st.get("dock_size") or 44)
    r["dock_autohide"] = bool(st.get("dock_autohide", False))
    return r


def bar_style_for(r, wm):
    return r["bar_style"] if r["bar_style"] in BAR_STYLES else ("cachyos-minimal" if wm == "icewm" else "classic")


def all_rices():
    out = []
    for d in (RICES, USER_RICES):
        for p in sorted(d.glob("*.json")) if d.exists() else []:
            try:
                x = json.loads(p.read_text()); x["id"] = p.stem; x["user"] = d == USER_RICES; out.append(x)
            except Exception:
                pass
    return sorted(out, key=lambda d: (d.get("user", False), d.get("order", 99)))


def state():
    try:
        return json.loads(STATE.read_text())
    except Exception:
        return {}


def save_state(**kw):
    st = state(); st.update(kw)
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp"); tmp.write_text(json.dumps(st, indent=2)); tmp.replace(STATE)


def installed():
    return [d for d, (binary, _, _) in DESKTOPS.items() if shutil.which(binary)]


def running():
    cur = (os.environ.get("XDG_CURRENT_DESKTOP", "") + ":" + os.environ.get("DESKTOP_SESSION", "")).lower()
    for key, names in [("hyprland", ["hyprland"]), ("niri", ["niri"]), ("sway", ["sway"]), ("i3", ["i3"]),
                       ("openbox", ["openbox"]), ("icewm", ["icewm"]), ("xfce", ["xfce"]),
                       ("gnome", ["gnome"]), ("kde", ["kde", "plasma"]), ("cosmic", ["cosmic"])]:
        if any(n in cur for n in names):
            return key
    return None


def write(path, text, mode=0o644):
    path = Path(path); path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".grimtmp"); tmp.write_text(text); os.chmod(tmp, mode); tmp.replace(path)


def backup_once(path):
    """Keep the user's own file the first time Grim overwrites it."""
    path = Path(path)
    if path.exists() and not path.with_name(path.name + ".pre-grim").exists():
        txt = path.read_text(errors="ignore")
        if "Grim OS" not in txt:
            shutil.copy2(path, path.with_name(path.name + ".pre-grim"))


def run(*cmd, quiet=True):
    try:
        return subprocess.run(cmd, stdout=subprocess.DEVNULL if quiet else None,
                              stderr=subprocess.DEVNULL if quiet else None, timeout=20).returncode
    except Exception:
        return 1


def spawn(*cmd):
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except FileNotFoundError:
        pass


def hx(c):  # "#rrggbb" -> "rrggbb"
    return c.lstrip("#")


def rgba(c, a="ff"):
    return f"rgba({hx(c)}{a})"


def ansi(r):
    """16 terminal colours that suit the rice."""
    c = r["colors"]
    if r["id"] == "nord-snow":
        return ["#3b4252", "#bf616a", "#a3be8c", "#ebcb8b", "#81a1c1", "#b48ead", "#88c0d0", "#e5e9f0",
                "#4c566a", "#bf616a", "#a3be8c", "#ebcb8b", "#81a1c1", "#b48ead", "#8fbcbb", "#eceff4"]
    if r.get("dark", True):
        return ["#1f1f23", c["accent"], "#7fa86b", "#d6a85c", "#6f8fb5", "#a97ab0", "#6fa8a8", "#cfcfcf",
                "#3a3a40", c.get("accent2", c["accent"]), "#98c283", "#e8c27a", "#8aa9cf", "#c495ca", "#8cc4c4", "#ffffff"]
    return ["#161616", "#c1121f", "#3f7a2e", "#946200", "#2f5d8a", "#7a3f86", "#2c7372", "#d3d1c9",
            "#4a4a4a", "#e0323f", "#4f9a3a", "#b37a00", "#3c76ad", "#9a52a8", "#389290", "#ecebe6"]


# ------------------------------------------------------------------ shared app configs
def gen_common(r):
    c = r["colors"]; a = ansi(r); f = r["font"]; fs = r["font_size"]
    t = r["term"]; tf, tfs, op, pad = t["font"], t["size"], float(t["opacity"]), int(t["padding"])
    # Terminals
    names = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
    normal = "\n".join(f'{n} = "{a[i]}"' for i, n in enumerate(names))
    bright = "\n".join(f'{n} = "{a[i + 8]}"' for i, n in enumerate(names))
    write(CFG / "alacritty/alacritty.toml", f"""# Grim OS rice: {r['name']} (written by grim-rice, changes are overwritten)
[window]
padding = {{ x = {pad}, y = {max(pad - 2, 0)} }}
decorations = "None"
opacity = {op:.2f}

[font]
size = {tfs}
normal = {{ family = "{tf}" }}

[colors.primary]
background = "{c['bg']}"
foreground = "{c['fg']}"

[colors.cursor]
text = "{c['bg']}"
cursor = "{c['accent']}"

[colors.normal]
{normal}

[colors.bright]
{bright}
""")
    write(CFG / "foot/foot.ini", f"""# Grim OS rice: {r['name']}
[main]
font={tf}:size={tfs}
pad={pad}x{max(pad - 2, 0)}

[colors]
alpha={op:.2f}
background={hx(c['bg'])}
foreground={hx(c['fg'])}
""" + "".join(f"regular{i}={hx(a[i])}\n" for i in range(8)) + "".join(f"bright{i}={hx(a[i + 8])}\n" for i in range(8)))
    kitty = f"# Grim OS rice: {r['name']}\nfont_family {tf}\nfont_size {tfs}\nwindow_padding_width {pad}\nbackground_opacity {op:.2f}\n" \
            f"background {c['bg']}\nforeground {c['fg']}\ncursor {c['accent']}\n" \
            + "".join(f"color{i} {a[i]}\n" for i in range(16))
    write(CFG / "kitty/grim-theme.conf", kitty)
    kc = CFG / "kitty/kitty.conf"
    if not kc.exists() or "grim-theme.conf" not in kc.read_text():
        with open(kc, "a") as fh:
            fh.write("\n# Grim OS colours\ninclude grim-theme.conf\n")

    # grimfetch when a terminal opens (Terminal page)
    rc = HOME / ".bashrc"
    try:
        txt = rc.read_text() if rc.exists() else ""
        block = "# >>> grimfetch (Grim Settings) >>>\n[ -n \"$PS1\" ] && [ -z \"$GRIM_BANNER_SHOWN\" ] && command -v grimfetch >/dev/null && grimfetch\n# <<< grimfetch <<<\n"
        txt = re.sub(r"# >>> grimfetch \(Grim Settings\) >>>.*?# <<< grimfetch <<<\n", "", txt, flags=re.S)
        if t.get("fetch"):
            txt = txt.rstrip("\n") + "\n\n" + block
        rc.write_text(txt)
    except OSError:
        pass

    # App finder
    write(CFG / "rofi/config.rasi", f"""/* Grim OS rice: {r['name']} */
configuration {{
    modes: "drun,run,window";
    show-icons: true;
    icon-theme: "{r['icon_theme']}";
    display-drun: "";
    drun-display-format: "{{name}}";
}}
* {{ bg: {c['bg2']}; bg3: {c['bg3']}; fg: {c['fg']}; mu: {c['muted']}; ac: {c['accent']}; af: {c['accent_fg']};
    background-color: transparent; text-color: @fg; font: "{f} {fs + 1}"; }}
window {{ width: 560px; background-color: @bg; border: {r['border']}px; border-color: @ac; border-radius: {r['radius']}px; padding: 14px; }}
inputbar {{ children: [prompt, entry]; spacing: 10px; padding: 8px 10px; background-color: @bg3; border-radius: {max(r['radius'] - 2, 0)}px; }}
prompt {{ text-color: @ac; }}
entry {{ placeholder: "Search apps"; placeholder-color: @mu; }}
listview {{ lines: 8; spacing: 2px; margin: 10px 0 0 0; scrollbar: false; }}
element {{ padding: 7px 10px; spacing: 10px; border-radius: {max(r['radius'] - 2, 0)}px; }}
element selected {{ background-color: @ac; text-color: @af; }}
element-text {{ text-color: inherit; vertical-align: 0.5; }}
element-icon {{ size: 22px; }}
""")
    # Notifications
    write(CFG / "dunst/dunstrc", f"""# Grim OS rice: {r['name']}
[global]
font = {f} {fs}
frame_width = {r['border']}
frame_color = "{c['accent']}"
corner_radius = {r['radius']}
offset = (14, 40)
background = "{c['bg2']}"
foreground = "{c['fg']}"
[urgency_critical]
frame_color = "{c['urgent']}"
background = "{c['bg2']}"
foreground = "{c['fg']}"
""")
    write(CFG / "mako/config", f"""# Grim OS rice: {r['name']}
font={f} {fs}
background-color={c['bg2']}
text-color={c['fg']}
border-color={c['accent']}
border-size={r['border']}
border-radius={r['radius']}
default-timeout=6000
""")
    # GTK apps
    for v in ("gtk-3.0", "gtk-4.0"):
        write(CFG / v / "settings.ini", f"""[Settings]
gtk-theme-name={r['gtk_theme']}
gtk-icon-theme-name={r['icon_theme']}
gtk-font-name=Noto Sans 10
gtk-application-prefer-dark-theme={'true' if r.get('dark', True) else 'false'}
""")


# ------------------------------------------------------------------ bars
def classic_right(r):
    m = r["bar_modules"]
    out = (["wlan", "eth"] if "network" in m else []) + ["fs", "temperature"]
    out += [x for k, x in (("memory", "memory"), ("battery", "battery"), ("tray", "tray"), ("power", "power")) if k in m]
    return out


def gen_polybar(r, wm):
    c = r["colors"]; f = r["font"]; fs = r["font_size"]
    ws = "internal/i3" if wm == "i3" else "internal/xworkspaces"
    ws_block = f"""[module/workspaces]
type = {ws}
pin-workspaces = true
label-focused = " %name% "
label-focused-background = {c['accent']}
label-focused-foreground = {c['accent_fg']}
label-unfocused = " %name% "
label-visible = " %name% "
label-urgent = " %name% "
label-urgent-background = {c['urgent']}
""" if wm == "i3" else f"""[module/workspaces]
type = {ws}
label-active = " %name% "
label-active-background = {c['accent']}
label-active-foreground = {c['accent_fg']}
label-occupied = " %name% "
label-empty = " %name% "
label-empty-foreground = {c['muted']}
label-urgent = " %name% "
"""
    write(GEN / "polybar.ini", f"""; Grim OS rice: {r['name']} (written by grim-rice)
[colors]
bg = {c['bg2']}
fg = {c['fg']}
mu = {c['muted']}
ac = {c['accent']}
af = {c['accent_fg']}
lab = {c.get('accent2', c['accent'])}

[bar/grim]
width = 100%
height = 26
bottom = {'true' if r['bar_position'] == 'bottom' else 'false'}
background = ${{colors.bg}}
foreground = ${{colors.fg}}
font-0 = "{f}:size={fs};3"
padding-left = 1
padding-right = 1
module-margin = 1
modules-left = workspaces {"volume " if "volume" in r["bar_modules"] else ""}keyboard
modules-center = date
modules-right = {" ".join(classic_right(r))}
cursor-click = pointer
enable-ipc = true
{'wm-restack = i3' if wm == 'i3' else 'wm-restack = generic'}
override-redirect = false

{ws_block}
[module/volume]
type = custom/script
exec = grim-volume
interval = 2
click-left = pactl set-sink-mute @DEFAULT_SINK@ toggle
scroll-up = pactl set-sink-volume @DEFAULT_SINK@ +5%
scroll-down = pactl set-sink-volume @DEFAULT_SINK@ -5%
format-prefix = "{IC['vol']} "
format-prefix-foreground = ${{colors.mu}}

[module/keyboard]
type = internal/xkeyboard
format = <label-layout>
label-layout = %layout%
label-layout-foreground = ${{colors.ac}}
blacklist-0 = num lock
blacklist-1 = scroll lock

[module/date]
type = internal/date
interval = 5
date = %A, %B %d %Y
time = {"%H:%M" if r["clock24"] else "%I:%M %p"}
label = "  %date%  %time%  "
label-background = ${{colors.ac}}
label-foreground = ${{colors.af}}

[module/wlan]
type = internal/network
interface-type = wireless
label-connected = %local_ip%
format-connected-prefix = "{IC['wifi']} "
format-connected-prefix-foreground = ${{colors.mu}}
label-disconnected =

[module/eth]
type = internal/network
interface-type = wired
label-connected = %local_ip%
format-connected-prefix = "{IC['eth']} "
format-connected-prefix-foreground = ${{colors.mu}}
label-disconnected =

[module/fs]
type = internal/fs
mount-0 = /
label-mounted = / %percentage_used%%

[module/temperature]
type = internal/temperature
warn-temperature = 80
format-prefix = "{IC['temp']} "
format-prefix-foreground = ${{colors.mu}}
label = %temperature-c%

[module/memory]
type = internal/memory
format-prefix = "{IC['mem']} "
format-prefix-foreground = ${{colors.mu}}
label = %percentage_used%%

[module/battery]
type = internal/battery
full-at = 99
format-charging-prefix = "{IC['chg']} "
format-discharging-prefix = "{IC['bat']} "
format-full-prefix = "{IC['bat']} "
label-charging = %percentage%%
label-discharging = %percentage%%
label-full = %percentage%%

[module/tray]
type = internal/tray
tray-spacing = 6

[module/power]
type = custom/text
label = {IC['power']}
label-foreground = ${{colors.ac}}
click-left = grim-power
""")


def gen_polybar_minimal(r):
    """The 'minimal' bar from the author's CachyOS rice: launcher, workspace pill, centred clock,
    icon-only status on the right, power in red. Used on IceWM (its taskbar is hidden)."""
    c = r["colors"]; f = r["font"]; fs = r["font_size"]
    L, R = "\ue0b6", "\ue0b4"   # rounded pill ends
    pill = lambda txt: f"%{{F{c['accent']}}}{L}%{{F{c['accent_fg']} B{c['accent']}}}{txt}%{{B- F{c['accent']}}}{R}%{{F-}}"
    write(GEN / "polybar-minimal.ini", f"""; Grim OS rice: {r['name']}, minimal layout (written by grim-rice)
[colors]
bg = {c['bg']}
fg = {c['fg']}
mu = {c['muted']}
ac = {c['accent']}
red = {c['urgent']}

[bar/grim]
width = 100%
height = 31
bottom = {'true' if r['bar_position'] == 'bottom' else 'false'}
background = ${{colors.bg}}
foreground = ${{colors.fg}}
font-0 = "{f}:size={fs};3"
font-1 = "{f}:size={fs + 2}:weight=bold;3"
padding-left = 2
padding-right = 2
module-margin = 1
modules-left = launcher workspaces
modules-center = clock
modules-right = backlight wlan eth volume settings battery notifications updates monitor power
cursor-click = pointer
enable-ipc = true
wm-restack = generic

[module/launcher]
type = custom/text
label = {IC['skull']}
label-foreground = ${{colors.ac}}
click-left = grim-apps

[module/workspaces]
type = internal/xworkspaces
label-active = "{pill(' %name% ')}"
label-occupied = " %name% "
label-occupied-foreground = ${{colors.fg}}
label-empty = " %name% "
label-empty-foreground = ${{colors.mu}}
label-urgent = " %name% "
label-urgent-foreground = ${{colors.red}}

[module/clock]
type = internal/date
interval = 5
date = %H:%M
label = %{{T2}}%date%%{{T-}}

[module/backlight]
type = custom/script
exec = grim-backlight
interval = 5

[module/wlan]
type = internal/network
interface-type = wireless
label-connected = {IC['wifi']}
label-disconnected = {IC['wifi_off']}
label-disconnected-foreground = ${{colors.mu}}

[module/eth]
type = internal/network
interface-type = wired
label-connected = {IC['eth']}
label-disconnected =

[module/volume]
type = custom/script
exec = grim-volume --icon
interval = 2
click-left = pactl set-sink-mute @DEFAULT_SINK@ toggle
scroll-up = pactl set-sink-volume @DEFAULT_SINK@ +5%
scroll-down = pactl set-sink-volume @DEFAULT_SINK@ -5%

[module/settings]
type = custom/text
label = {IC['gear']}
click-left = grim-settings

[module/battery]
type = internal/battery
full-at = 99
format-charging = <label-charging>
label-charging = {IC['chg']}
format-discharging = <ramp-capacity>
ramp-capacity-0 = {IC['bat0']}
ramp-capacity-0-foreground = ${{colors.red}}
ramp-capacity-1 = {IC['bat1']}
ramp-capacity-2 = {IC['bat2']}
ramp-capacity-3 = {IC['bat3']}
ramp-capacity-4 = {IC['bat']}
label-full = {IC['bat']}

[module/notifications]
type = custom/script
exec = dunstctl is-paused 2>/dev/null | grep -q true && echo "{IC['bell_off']}" || echo "{IC['bell']}"
interval = 2
click-left = dunstctl set-paused toggle

[module/updates]
type = custom/script
exec = grim-updates-count
interval = 1800
click-left = grim-term -e update

[module/monitor]
type = custom/text
label = {IC['gauge']}
click-left = grim-term -e top

[module/power]
type = custom/text
label = {IC['power']}
label-foreground = ${{colors.red}}
click-left = grim-power
""")


def gen_polybar_style(r, wm, style):
    """Writes GEN/polybar.ini for one of the BAR_STYLES and returns the bar names to start."""
    if style == "classic":
        gen_polybar(r, wm)
        return ["grim"]
    c = r["colors"]; f = r["font"]; fs = r["font_size"]; m = r["bar_modules"]
    dots = style in ("reaper-pills", "red-island", "frost-glass", "graphite-icons")
    icons_only = style in ("graphite-icons", "cachyos-minimal")
    floating = style in ("reaper-pills", "nord-pills", "red-island", "frost-glass")
    h = r["bar_height"] + (3 if style == "cachyos-minimal" else 0)
    bottom = r["bar_position"] == "bottom"
    L, R = "", ""
    pill = lambda txt: f"%{{F{c['accent']}}}{L}%{{F{c['accent_fg']} B{c['accent']}}}{txt}%{{B- F{c['accent']}}}{R}%{{F-}}"
    if dots:
        act, occ, emp = f"%{{F{c['accent']}}}{IC['dot']}%{{F-}}", IC["dot"], IC["ring"]
    else:
        act, occ, emp = pill(" %name% "), " %name% ", " %name% "
    if wm == "i3":
        ws = f"""[module/workspaces]
type = internal/i3
pin-workspaces = true
format = <label-state>
label-focused = "{act}"
label-unfocused = "{occ if dots else ' %name% '}"
label-unfocused-foreground = ${{colors.mu}}
label-visible = "{occ if dots else ' %name% '}"
label-urgent = "{occ if dots else ' %name% '}"
label-urgent-foreground = ${{colors.red}}
label-separator = " "
"""
    else:
        ws = f"""[module/workspaces]
type = internal/xworkspaces
label-active = "{act}"
label-occupied = "{occ}"
label-occupied-foreground = ${{colors.fg}}
label-empty = "{emp}"
label-empty-foreground = ${{colors.mu}}
label-urgent = "{occ}"
label-urgent-foreground = ${{colors.red}}
label-active-padding = 1
label-occupied-padding = 1
label-empty-padding = 1
"""
    txt = lambda s_: "" if icons_only else s_
    mods = f"""[module/launcher]
type = custom/text
label = {IC['skull']}
label-foreground = ${{colors.ac}}
click-left = grim-apps

{ws}
[module/clock]
type = internal/date
interval = 5
date = {"%H:%M" if r["clock24"] else "%I:%M %p"}
label = %{{T2}}%date%%{{T-}}

[module/volume]
type = custom/script
exec = {"grim-volume --icon" if icons_only else "echo $(grim-volume --icon) $(pactl get-sink-volume @DEFAULT_SINK@ | grep -oE '[0-9]+%' | head -1)"}
interval = 2
click-left = pactl set-sink-mute @DEFAULT_SINK@ toggle
scroll-up = pactl set-sink-volume @DEFAULT_SINK@ +5%
scroll-down = pactl set-sink-volume @DEFAULT_SINK@ -5%

[module/network]
type = internal/network
interface-type = wireless
label-connected = {IC['wifi']}{txt(' %essid%')}
label-disconnected = {IC['wifi_off']}
label-disconnected-foreground = ${{colors.mu}}

[module/battery]
type = internal/battery
full-at = 99
format-charging = <label-charging>
label-charging = {IC['chg']}{txt(' %percentage%%')}
format-discharging = <ramp-capacity>{"" if icons_only else " <label-discharging>"}
label-discharging = %percentage%%
ramp-capacity-0 = {IC['bat0']}
ramp-capacity-0-foreground = ${{colors.red}}
ramp-capacity-1 = {IC['bat1']}
ramp-capacity-2 = {IC['bat2']}
ramp-capacity-3 = {IC['bat3']}
ramp-capacity-4 = {IC['bat']}
label-full = {IC['bat']}{txt(' 100%')}

[module/cpu]
type = internal/cpu
interval = 3
label = {IC['gauge']}{txt(' %percentage%%')}

[module/memory]
type = internal/memory
label = {IC['mem']}{txt(' %percentage_used%%')}

[module/updates]
type = custom/script
exec = grim-updates-count
interval = 1800
click-left = grim-term -e update

[module/tray]
type = internal/tray
tray-spacing = 6

[module/power]
type = custom/text
label = {IC['power']}
label-foreground = ${{colors.red}}
click-left = grim-power
"""
    right = " ".join(x for x in BAR_MODULES if x in m)
    left = ("launcher " if style in ("reaper-pills", "graphite-icons", "cachyos-minimal") else "") + "workspaces"
    glass_bg = "#99" + hx(c["bg2"]) if style == "frost-glass" else c["bg2"] if floating else c["bg"]

    def bar(name, width, offset, mleft="", mcenter="", mright="", radius=0, border=0):
        return f"""[bar/{name}]
width = {width}
height = {h}
offset-x = {offset}
offset-y = {8 if floating else 0}
radius = {radius}
bottom = {"true" if bottom else "false"}
background = {glass_bg}
foreground = ${{colors.fg}}
border-size = {border}
border-color = {c['accent']}
font-0 = "{f}:size={fs};3"
font-1 = "{f}:size={fs + 1}:weight=bold;3"
padding-left = 2
padding-right = 2
module-margin = 1
modules-left = {mleft}
modules-center = {mcenter}
modules-right = {mright}
fixed-center = true
cursor-click = pointer
enable-ipc = true
wm-restack = {"i3" if wm == "i3" else "generic"}

"""
    rad = h / 2
    if style in ("reaper-pills", "nord-pills"):
        bars = bar("left", "20%", "12", mleft=left, radius=rad) + bar("center", "9%", "45.5%", mcenter="clock", radius=rad) \
             + bar("right", "26%", "74%:-12", mright=right, radius=rad)
        names = ["left", "center", "right"]
    elif style == "red-island":
        bars = bar("grim", "46%", "27%", mleft=left, mcenter="clock", mright=right, radius=rad)
        names = ["grim"]
    elif style == "frost-glass":
        bars = bar("grim", "100%:-24", "12", mleft=left, mcenter="clock", mright=right, radius=12, border=1)
        names = ["grim"]
    else:  # graphite-icons, cachyos-minimal: full strip
        bars = bar("grim", "100%", "0", mleft=left, mcenter="clock", mright=right)
        names = ["grim"]
    write(GEN / "polybar.ini", f"""; Grim OS rice: {r['name']}, bar style {BAR_STYLES[style][0]} (written by grim-rice)
[colors]
fg = {c['fg']}
mu = {c['muted']}
ac = {c['accent']}
red = {c['urgent']}

{bars}{mods}""")
    return names


def gen_waybar(r, wm):
    c = r["colors"]; m = r["bar_modules"]
    style = bar_style_for(r, wm)
    ws = {"sway": "sway/workspaces", "hyprland": "hyprland/workspaces", "niri": "niri/workspaces"}[wm]
    lang = {"sway": "sway/language", "hyprland": "hyprland/language", "niri": "niri/language"}[wm]
    clockfmt = "%H:%M" if r["clock24"] else "%I:%M %p"
    dots = style in ("reaper-pills", "red-island", "frost-glass", "graphite-icons")
    icons_only = style in ("graphite-icons", "cachyos-minimal")
    floating = style in ("reaper-pills", "nord-pills", "red-island", "frost-glass")
    t = lambda s_: "" if icons_only else s_
    ws_conf = {"format": "{icon}", "format-icons": {"focused": IC["dot"], "active": IC["dot"], "urgent": IC["dot"], "default": IC["ring"]}} if dots \
        else ({"format": "{name}"} if wm != "niri" else {"format": "{index}"})
    mod_conf = {
        ws: ws_conf,
        "custom/launcher": {"format": IC["skull"], "on-click": "grim-apps", "tooltip": False},
        "custom/volume": {"exec": "grim-volume --icon" if style != "classic" else "grim-volume", "interval": 2,
                          "format": "{}" if style != "classic" else IC["vol"] + " {}",
                          "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
                          "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
                          "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"},
        lang: {"format": "{short}"} if wm != "niri" else {"format": "{}"},
        "clock": {"format": ("{:%A, %B %d %Y  " + clockfmt + "}") if style == "classic" else "{:" + clockfmt + "}", "interval": 5},
        "network": {"format-wifi": IC["wifi"] + (" {ipaddr}" if style == "classic" else t(" {essid}")),
                    "format-ethernet": IC["eth"] + (" {ipaddr}" if style == "classic" else ""),
                    "format-disconnected": IC["wifi_off"], "tooltip-format": "{essid} {ifname} {ipaddr}"},
        "disk": {"format": "/ {percentage_used}%", "path": "/"},
        "temperature": {"format": IC["temp"] + " {temperatureC}°C"},
        "cpu": {"format": IC["gauge"] + t(" {usage}%"), "interval": 3},
        "memory": {"format": IC["mem"] + t(" {percentage}%")},
        "battery": {"format": "{icon}" + t(" {capacity}%"), "format-charging": IC["chg"] + t(" {capacity}%"),
                    "format-icons": [IC["bat0"], IC["bat1"], IC["bat2"], IC["bat3"], IC["bat"]]},
        "custom/updates": {"exec": "grim-updates-count", "interval": 1800, "on-click": "grim-term -e update"},
        "tray": {"spacing": 6},
        "custom/power": {"format": IC["power"], "on-click": "grim-power", "tooltip": False},
    }
    name = {"volume": "custom/volume", "network": "network", "battery": "battery", "cpu": "cpu", "memory": "memory",
            "updates": "custom/updates", "tray": "tray", "power": "custom/power"}
    right = [name[x] for x in BAR_MODULES if x in m]
    if style == "classic":
        left = [ws] + (["custom/volume"] if "volume" in m else []) + [lang]
        right = [x for x in (["network"] if "network" in m else []) + ["disk", "temperature"] +
                 [name[k] for k in ("memory", "battery", "tray", "power") if k in m]]
    else:
        left = (["custom/launcher"] if style in ("reaper-pills", "graphite-icons", "cachyos-minimal") else []) + [ws]
    conf = {"layer": "top", "position": r["bar_position"], "height": r["bar_height"] + (3 if style == "cachyos-minimal" else 0),
            "spacing": 8, "modules-left": left, "modules-center": ["clock"], "modules-right": right}
    if style == "red-island":
        conf.update({"modules-left": [], "modules-center": left + ["clock"] + right, "modules-right": []})
    if floating:
        conf.update({"margin-top": 8 if r["bar_position"] == "top" else 0, "margin-bottom": 8 if r["bar_position"] == "bottom" else 0,
                     "margin-left": 12, "margin-right": 12})
    conf.update(mod_conf)
    write(GEN / f"waybar-{wm}.json", json.dumps(conf, indent=2, ensure_ascii=False))

    base = f"""/* Grim OS rice: {r['name']}, bar style {BAR_STYLES[style][0]} */
* {{ font-family: "{r['font']}"; font-size: {r['font_size'] + 2}px; min-height: 0; border: none; border-radius: 0; }}
#workspaces button {{ padding: 0 6px; color: {c['muted']}; background: transparent; }}
#workspaces button.urgent {{ color: {c['urgent']}; }}
#custom-launcher {{ color: {c['accent']}; padding: 0 6px; }}
#custom-power {{ color: {c['urgent']}; padding: 0 8px 0 4px; }}
#clock {{ font-weight: bold; }}
#tray, #network, #battery, #cpu, #memory, #custom-volume, #custom-updates, #disk, #temperature {{ padding: 0 5px; }}
#battery.critical {{ color: {c['urgent']}; }}
"""
    if dots:
        active = f"#workspaces button.focused, #workspaces button.active {{ color: {c['accent']}; }}\n"
    else:
        active = f"#workspaces button.focused, #workspaces button.active {{ background: {c['accent']}; color: {c['accent_fg']}; border-radius: 999px; }}\n"
    bg2 = c["bg2"]; r_, g_, b_ = (int(bg2[i:i + 2], 16) for i in (1, 3, 5))
    css = {
        "classic": f"""window#waybar {{ background: {bg2}; color: {c['fg']}; }}
#workspaces button.focused, #workspaces button.active {{ background: {c['accent']}; color: {c['accent_fg']}; }}
#clock {{ background: {c['accent']}; color: {c['accent_fg']}; padding: 0 14px; }}
#language {{ color: {c['accent']}; }}
""",
        "reaper-pills": f"""window#waybar {{ background: transparent; color: {c['fg']}; }}
.modules-left, .modules-center, .modules-right {{ background: {bg2}; border-radius: 999px; padding: 0 12px; }}
""",
        "red-island": f"""window#waybar {{ background: transparent; color: {c['fg']}; }}
.modules-center {{ background: {bg2}; border-radius: 999px; padding: 0 16px; }}
""",
        "frost-glass": f"""window#waybar {{ background: rgba({r_}, {g_}, {b_}, 0.6); color: {c['fg']}; border: 1px solid {c['accent']}; border-radius: 12px; }}
""",
        "graphite-icons": f"""window#waybar {{ background: {c['bg']}; color: {c['fg']}; }}
""",
        "cachyos-minimal": f"""window#waybar {{ background: {c['bg']}; color: {c['fg']}; }}
""",
    }
    css["nord-pills"] = css["reaper-pills"]
    write(GEN / "waybar.css", base + active + css[style])


def gen_picom(r):
    write(GEN / "picom.conf", f"""# Grim OS rice: {r['name']}
backend = "glx";
vsync = true;
corner-radius = {r['radius']};
rounded-corners-exclude = [ "class_g = 'Polybar'", "window_type = 'dock'", "window_type = 'desktop'" ];
shadow = {'true' if r.get('dark', True) else 'false'};
shadow-radius = 14;
shadow-opacity = 0.35;
shadow-exclude = [ "class_g = 'Polybar'", "window_type = 'dock'", "_GTK_FRAME_EXTENTS@" ];
fading = true;
fade-delta = 6;
""")


# ------------------------------------------------------------------ per desktop
def gen_i3(r):
    c = r["colors"]; b = r["border"]
    p = CFG / "i3/config"; backup_once(p)
    ws = "\n".join(f"bindsym $mod+{i} workspace number {i}\nbindsym $mod+Shift+{i} move container to workspace number {i}"
                   for i in range(1, 10))
    write(p, f"""# Grim OS rice: {r['name']} (written by grim-rice; your old file is i3/config.pre-grim)
# Super+T float  Super+Q close  Super+Space apps  Super+Return terminal  Print screenshot
# Super+left-drag move, Super+right-drag resize. Super+F1 Grim Settings.
set $mod Mod4
font pango:{r['font']} {r['font_size']}
floating_modifier $mod
tiling_drag modifier titlebar
focus_follows_mouse no

default_border pixel {b}
default_floating_border pixel {b}
hide_edge_borders none
gaps inner {r['gaps']}
gaps outer 0

#                       border          background      text            indicator       child_border
client.focused          {c['border_active']} {c['bg']} {c['fg']} {c['accent']} {c['border_active']}
client.focused_inactive {c['border_inactive']} {c['bg']} {c['muted']} {c['border_inactive']} {c['border_inactive']}
client.unfocused        {c['border_inactive']} {c['bg']} {c['muted']} {c['border_inactive']} {c['border_inactive']}
client.urgent           {c['urgent']} {c['bg']} {c['fg']} {c['urgent']} {c['urgent']}
client.background       {c['bg']}

bindsym $mod+t floating toggle
bindsym $mod+q kill
bindsym $mod+space exec --no-startup-id grim-apps
bindsym $mod+Return exec --no-startup-id grim-term
bindsym Print exec --no-startup-id grim-shot
bindsym $mod+F1 exec --no-startup-id grim-settings
bindsym $mod+Shift+e exec --no-startup-id grim-power
bindsym $mod+Shift+r restart
bindsym $mod+f fullscreen toggle
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space focus mode_toggle

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
{ws}

mode "resize" {{
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Escape mode "default"
    bindsym Return mode "default"
}}
bindsym $mod+r mode "resize"

for_window [window_role="pop-up"] floating enable
for_window [window_type="dialog"] floating enable
for_window [class="os.grim.Settings|Pavucontrol"] floating enable

exec_always --no-startup-id grim-rice session i3
""")



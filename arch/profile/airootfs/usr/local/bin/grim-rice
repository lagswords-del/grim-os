""")


def gen_hyprland(r):
    c = r["colors"]
    src = Path("/usr/share/hypr/hyprland.lua")
    if not src.exists():
        return
    s = src.read_text()
    s = s.replace('local terminal    = "kitty"', 'local terminal    = "grim-term"')
    s = s.replace('local fileManager = "dolphin"', 'local fileManager = "grim-term"')
    s = s.replace('local menu        = "hyprlauncher"', 'local menu        = "grim-apps"')
    s = s.replace('hl.bind(mainMod .. " + Q", hl.dsp.exec_cmd(terminal))', 'hl.bind(mainMod .. " + RETURN", hl.dsp.exec_cmd(terminal))')
    s = s.replace('hl.bind(mainMod .. " + C", hl.dsp.window.close())', 'hl.bind(mainMod .. " + Q", hl.dsp.window.close())')
    s = s.replace('hl.bind(mainMod .. " + V", hl.dsp.window.float({ action = "toggle" }))', 'hl.bind(mainMod .. " + T", hl.dsp.window.float({ action = "toggle" }))')
    s = s.replace('hl.bind(mainMod .. " + R", hl.dsp.exec_cmd(menu))', 'hl.bind(mainMod .. " + SPACE", hl.dsp.exec_cmd(menu))\n'
                  'hl.bind("Print", hl.dsp.exec_cmd("grim-shot"))\n'
                  'hl.bind(mainMod .. " + F1", hl.dsp.exec_cmd("grim-settings"))\n'
                  'hl.bind(mainMod .. " + SHIFT + E", hl.dsp.exec_cmd("grim-power"))')
    s = re.sub(r'active_border\s*=\s*\{[^}]*\}[^,\n]*,', f'active_border   = "{rgba(c["border_active"])}",', s, count=1)
    s = re.sub(r'inactive_border\s*=\s*"[^"]*"', f'inactive_border = "{rgba(c["border_inactive"])}"', s, count=1)
    s = re.sub(r'gaps_in\s*=\s*\d+', f'gaps_in  = {max(r["gaps"] // 2, 2)}', s, count=1)
    s = re.sub(r'gaps_out\s*=\s*\d+', f'gaps_out = {r["gaps"]}', s, count=1)
    s = re.sub(r'border_size\s*=\s*\d+', f'border_size = {r["border"]}', s, count=1)
    s = re.sub(r'rounding\s*=\s*\d+', f'rounding       = {r["radius"]}', s, count=1)
    m = re.search(r'XkbLayout"\s+"([^"]+)"', Path("/etc/X11/xorg.conf.d/00-keyboard.conf").read_text()) \
        if Path("/etc/X11/xorg.conf.d/00-keyboard.conf").exists() else None
    if m:
        s = re.sub(r'kb_layout\s*=\s*"us"', f'kb_layout  = "{m.group(1)}"', s, count=1)
    s += '\n-- Grim OS: bar, wallpaper, dock and notifications\nhl.on("hyprland.start", function ()\n  hl.exec_cmd("grim-rice session hyprland")\nend)\n'
    s = f"-- Grim OS rice: {r['name']} (written by grim-rice from Hyprland's example config)\n" + s
    p = CFG / "hypr/hyprland.lua"; backup_once(p); write(p, s)


def gen_niri(r):
    c = r["colors"]
    src = Path("/usr/share/doc/niri/default-config.kdl")
    if not src.exists():
        return
    s = src.read_text()
    s = re.sub(r'Mod\+T hotkey-overlay-title="[^"]*" \{ spawn "alacritty"; \}',
               'Mod+Return hotkey-overlay-title="Open a Terminal" { spawn "grim-term"; }\n'
               '    Mod+T hotkey-overlay-title="Toggle floating" { toggle-window-floating; }\n'
               '    Mod+Space hotkey-overlay-title="Find an app" { spawn "grim-apps"; }\n'
               '    Mod+F1 hotkey-overlay-title="Grim Settings" { spawn "grim-settings"; }', s)
    s = re.sub(r'Mod\+D hotkey-overlay-title="[^"]*" \{ spawn "fuzzel"; \}', 'Mod+D { spawn "grim-apps"; }', s)
    s = s.replace('spawn-at-startup "waybar"', 'spawn-at-startup "grim-rice" "session" "niri"')
    s = s.replace('active-color "#7fc8ff"', f'active-color "{c["border_active"]}"')
    s = s.replace('inactive-color "#505050"', f'inactive-color "{c["border_inactive"]}"')
    s = re.sub(r'(\n    gaps )\d+', rf'\g<1>{r["gaps"]}', s, count=1)
    s += f"""
// Grim OS: rounded corners from the rice
window-rule {{
    geometry-corner-radius {r['radius']}
    clip-to-geometry true
}}
window-rule {{
    match app-id="os.grim.Settings"
    open-floating true
}}
"""
    s = f"// Grim OS rice: {r['name']} (written by grim-rice from niri's default config)\n" + s
    p = CFG / "niri/config.kdl"; backup_once(p); write(p, s)


def gen_openbox(r):
    import xml.etree.ElementTree as ET
    c = r["colors"]
    src = Path("/etc/xdg/openbox/rc.xml")
    if not src.exists():
        return
    ns = "http://openbox.org/3.4/rc"
    ET.register_namespace("", ns)
    tree = ET.parse(src); root = tree.getroot()
    q = lambda t: f"{{{ns}}}{t}"

    def keybind(key, action, cmd=None):
        kb = ET.SubElement(kbd, q("keybind"), key=key)
        a = ET.SubElement(kb, q("action"), name=action)
        if cmd:
            ET.SubElement(a, q("command")).text = cmd

    kbd = root.find(q("keyboard"))
    for kb in list(kbd.findall(q("keybind"))):
        if kb.get("key") in ("W-t", "W-q", "W-space", "W-Return", "Print", "W-F1", "W-S-e"):
            kbd.remove(kb)
    keybind("W-t", "ToggleMaximize")
    keybind("W-q", "Close")
    keybind("W-space", "Execute", "grim-apps")
    keybind("W-Return", "Execute", "grim-term")
    keybind("Print", "Execute", "grim-shot")
    keybind("W-F1", "Execute", "grim-settings")
    keybind("W-S-e", "Execute", "grim-power")
    mouse = root.find(q("mouse"))
    for ctx in mouse.findall(q("context")):
        if ctx.get("name") == "Frame":
            for btn, act in (("W-Left", "Move"), ("W-Right", "Resize")):
                mb = ET.SubElement(ctx, q("mousebind"), button=btn, action="Drag")
                ET.SubElement(mb, q("action"), name=act)
            mb = ET.SubElement(ctx, q("mousebind"), button="W-Left", action="Press")
            ET.SubElement(mb, q("action"), name="Focus"); ET.SubElement(mb, q("action"), name="Raise")
    theme = root.find(q("theme"))
    theme.find(q("name")).text = "Grim"
    margins = root.find(q("margins"))
    if margins is not None:
        margins.find(q("top" if r["bar_position"] == "top" else "bottom")).text = "26"
    p = CFG / "openbox/rc.xml"; backup_once(p)
    p.parent.mkdir(parents=True, exist_ok=True)
    tree.write(p, xml_declaration=True, encoding="UTF-8")
    write(CFG / "openbox/autostart", "# Grim OS\ngrim-rice session openbox &\n")
    write(CFG / "openbox/menu.xml", """<?xml version="1.0" encoding="UTF-8"?>
<!-- Grim OS -->
<openbox_menu xmlns="http://openbox.org/3.4/menu">
<menu id="root-menu" label="Grim OS">
  <item label="Terminal"><action name="Execute"><command>grim-term</command></action></item>
  <item label="Find an app"><action name="Execute"><command>grim-apps</command></action></item>
  <item label="Grim Settings"><action name="Execute"><command>grim-settings</command></action></item>
  <item label="Help"><action name="Execute"><command>grim-term -e grimhelp</command></action></item>
  <separator/>
  <item label="Reconfigure"><action name="Reconfigure"/></item>
  <item label="Power"><action name="Execute"><command>grim-power</command></action></item>
</menu>
</openbox_menu>
""")
    write(HOME / ".themes/Grim/openbox-3/themerc", f"""# Grim OS rice: {r['name']}
border.width: {r['border']}
padding.width: 6
padding.height: 4
window.handle.width: 0
window.client.padding.width: 0
window.active.border.color: {c['border_active']}
window.inactive.border.color: {c['border_inactive']}
window.active.title.bg: flat solid
window.active.title.bg.color: {c['bg3']}
window.active.label.bg: parentrelative
window.active.label.text.color: {c['fg']}
window.active.label.text.font: {r['font']}:size={r['font_size']}:weight=bold
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: {c['bg2']}
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: {c['muted']}
window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: {c['fg']}
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: {c['accent']}
window.active.button.hover.image.color: {c['accent_fg']}
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: {c['accent']}
window.active.button.pressed.image.color: {c['accent_fg']}
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: {c['muted']}
menu.border.width: {r['border']}
menu.border.color: {c['accent']}
menu.title.bg: flat solid
menu.title.bg.color: {c['bg3']}
menu.title.text.color: {c['fg']}
menu.items.bg: flat solid
menu.items.bg.color: {c['bg2']}
menu.items.text.color: {c['fg']}
menu.items.disabled.text.color: {c['muted']}
menu.items.active.bg: flat solid
menu.items.active.bg.color: {c['accent']}
menu.items.active.text.color: {c['accent_fg']}
menu.separator.color: {c['border_inactive']}
osd.bg: flat solid
osd.bg.color: {c['bg2']}
osd.border.color: {c['accent']}
osd.label.text.color: {c['fg']}
osd.hilight.bg: flat solid
osd.hilight.bg.color: {c['accent']}
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: {c['bg3']}
""")


def gen_icewm(r):
    c = r["colors"]; d = HOME / ".icewm"
    for f in ("preferences", "keys", "prefoverride"):
        backup_once(d / f)
    write(d / "preferences", f"""# Grim OS rice: {r['name']} (written by grim-rice)
# Super+T maximize/restore (IceWM windows always float), Super+Q close
MouseWinMove="Super+Pointer_Button1"
MouseWinSize="Super+Pointer_Button3"
KeyWinClose="Super+q"
KeyWinMaximize="Super+t"
Win95Keys=0
ShowTaskBar=0
TaskBarAtTop={1 if r['bar_position'] == 'top' else 0}
ClickToFocus=1
DesktopBackgroundImage="{r['wall']}"
DesktopBackgroundScaled={1 if r['wall_mode'] in ('fill', 'fit') else 0}
DesktopBackgroundCenter={1 if r['wall_mode'] == 'center' else 0}
""")
    write(d / "keys", """# Grim OS
key "Super+space" grim-apps
key "Super+Return" grim-term
key "Print" grim-shot
key "Super+F1" grim-settings
key "Super+Shift+e" grim-power
""")
    write(d / "prefoverride", f"""# Grim OS rice: {r['name']} colours (override the theme)
Theme="default/default.theme"
TitleFontNameXft="{r['font']}:size={r['font_size']}:bold"
NormalFontNameXft="{r['font']}:size={r['font_size']}"
ColorActiveTitleBar="{c['bg3']}"
ColorNormalTitleBar="{c['bg2']}"
ColorActiveTitleBarText="{c['fg']}"
ColorNormalTitleBarText="{c['muted']}"
ColorActiveBorder="{c['border_active']}"
ColorNormalBorder="{c['border_inactive']}"
ColorDefaultTaskBar="{c['bg2']}"
ColorDefaultTaskBarText="{c['fg']}"
ColorActiveTaskBarApp="{c['accent']}"
ColorActiveTaskBarAppText="{c['accent_fg']}"
ColorNormalTaskBarApp="{c['bg3']}"
ColorNormalTaskBarAppText="{c['fg']}"
ColorActiveWorkspaceButton="{c['accent']}"
ColorActiveWorkspaceButtonText="{c['accent_fg']}"
ColorNormalWorkspaceButton="{c['bg3']}"
ColorNormalWorkspaceButtonText="{c['fg']}"
ColorActiveMenuItem="{c['accent']}"
ColorActiveMenuItemText="{c['accent_fg']}"
ColorNormalMenu="{c['bg2']}"
ColorNormalMenuItemText="{c['fg']}"
""")
    write(d / "startup", "#!/bin/sh\n# Grim OS\ngrim-rice session icewm &\n", 0o755)


def gen_kde(r):
    kw = shutil.which("kwriteconfig6")
    if not kw:
        return
    def k(f, g, key, val):
        groups = []
        for part in g.split("]["):
            groups += ["--group", part]
        run(kw, "--file", str(CFG / f), *groups, "--key", key, val)
    k("kglobalshortcutsrc", "kwin", "Window Close", "Meta+Q\tAlt+F4,Alt+F4,Close Window")
    k("kglobalshortcutsrc", "kwin", "Window Maximize", "Meta+T\tMeta+PgUp,Meta+PgUp,Maximize Window")
    k("kglobalshortcutsrc", "services][org.kde.krunner.desktop", "_launch", "Meta+Space\tAlt+Space\tAlt+F2")
    k("kglobalshortcutsrc", "services][org.kde.spectacle.desktop", "RectangularRegionScreenShot", "Print\tMeta+Shift+Print")
    k("kglobalshortcutsrc", "services][org.kde.spectacle.desktop", "_launch", "none")
    k("kwinrc", "MouseBindings", "CommandAllKey", "Meta")
    k("kwinrc", "MouseBindings", "CommandAll1", "Move")
    k("kwinrc", "MouseBindings", "CommandAll3", "Resize")
    autostart("kde", r)


def gen_cosmic(r):
    # COSMIC reads RON files. Untested on real COSMIC builds: if a shortcut is ignored, set it in COSMIC Settings.
    d = CFG / "cosmic/com.system76.CosmicSettings.Shortcuts/v1"
    write(d / "custom", """{
    (modifiers: [Super], key: "t"): ToggleWindowFloating,
    (modifiers: [Super], key: "q"): Close,
    (modifiers: [Super], key: "space"): System(Launcher),
    (modifiers: [Super], key: "Return"): Spawn("grim-term"),
    (modifiers: [Super], key: "F1"): Spawn("grim-settings"),
}
""")
    write(CFG / "cosmic/com.system76.CosmicTheme.Mode/v1/is_dark", "true" if r.get("dark", True) else "false")
    write(CFG / "cosmic/com.system76.CosmicBackground/v1/all", f"""(
    output: "all",
    source: Path("{r['wall']}"),
    filter_by_theme: false,
    rotation_frequency: 300,
    filter_method: Lanczos,
    scaling_mode: Zoom,
    sampling_method: Alphanumeric,
)
""")


def autostart(desk, r):
    write(CFG / f"autostart/grim-{desk}.desktop", f"""[Desktop Entry]
Type=Application
Name=Grim OS rice
Comment=Applies the Grim OS rice (wallpaper, keys, dock)
Exec=grim-rice session {desk}
OnlyShowIn={ {'xfce': 'XFCE', 'gnome': 'GNOME', 'kde': 'KDE'}[desk] };
X-GNOME-Autostart-enabled=true
""")


GENERATORS = {"i3": gen_i3, "sway": gen_sway, "hyprland": gen_hyprland, "niri": gen_niri,
              "openbox": gen_openbox, "icewm": gen_icewm, "kde": gen_kde, "cosmic": gen_cosmic,
              "xfce": lambda r: autostart("xfce", r), "gnome": lambda r: autostart("gnome", r)}


# ------------------------------------------------------------------ dock
def start_plank(r):
    run("pkill", "-x", "plank")
    if not r["dock"]:
        return
    path = "net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/"
    run("gsettings", "set", path, "position", r["dock_position"])
    run("gsettings", "set", path, "icon-size", str(r["dock_size"]))
    run("gsettings", "set", path, "hide-mode", "intelligent" if r["dock_autohide"] else "none")
    run("gsettings", "set", path, "theme", "Transparent")
    spawn("plank")


# ------------------------------------------------------------------ displays
def _out(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return ""


def displays_list():
    """Connected screens: [{name, modes: ["1920x1080@60.00"], mode, scale, can_scale}]. Empty = not managed here."""
    desk = running()
    out = []
    if desk == "sway":
        for o in json.loads(_out("swaymsg", "-t", "get_outputs", "-r") or "[]"):
            modes = sorted({f"{x['width']}x{x['height']}@{x['refresh'] / 1000:.2f}" for x in o.get("modes", [])},
                           key=lambda s_: [-float(v) for v in re.split("[x@]", s_)])
            cm = o.get("current_mode") or {}
            out.append({"name": o["name"], "modes": modes, "mode": f"{cm.get('width')}x{cm.get('height')}@{cm.get('refresh', 0) / 1000:.2f}",
                        "scale": o.get("scale", 1.0), "can_scale": True})
    elif desk == "hyprland":
        for o in json.loads(_out("hyprctl", "monitors", "-j") or "[]"):
            modes = [x.replace("Hz", "") for x in o.get("availableModes", [])]
            out.append({"name": o["name"], "modes": modes, "mode": f"{o['width']}x{o['height']}@{o['refreshRate']:.2f}",
                        "scale": o.get("scale", 1.0), "can_scale": True})
    elif desk == "niri":
        data = json.loads(_out("niri", "msg", "-j", "outputs") or "{}")
        for name, o in data.items():
            modes = [f"{x['width']}x{x['height']}@{x['refresh_rate'] / 1000:.2f}" for x in o.get("modes", [])]
            cur = o.get("current_mode")
            out.append({"name": name, "modes": modes, "mode": modes[cur] if cur is not None and cur < len(modes) else "",
                        "scale": (o.get("logical") or {}).get("scale", 1.0), "can_scale": True})
    elif desk in ("i3", "openbox", "icewm"):
        cur = None
        for line in _out("xrandr", "--query").splitlines():
            mm = re.match(r"^(\S+) connected", line)
            if mm:
                cur = {"name": mm.group(1), "modes": [], "mode": "", "scale": 1.0, "can_scale": False}; out.append(cur); continue
            if re.match(r"^\S", line):
                cur = None; continue
            mm = re.match(r"^\s+(\d+x\d+)\s+(.*)$", line)
            if cur and mm:
                for rate in re.findall(r"([\d.]+)([*+ ]*)", mm.group(2)):
                    cur["modes"].append(f"{mm.group(1)}@{float(rate[0]):.2f}")
                    if "*" in rate[1]:
                        cur["mode"] = f"{mm.group(1)}@{float(rate[0]):.2f}"
    return out


def display_set(name, mode, scale=1.0):
    res, _, hz = mode.partition("@")
    desk = running()
    if desk == "sway":
        return run("swaymsg", "output", name, "mode", f"{res}@{hz}Hz", "scale", str(scale))
    if desk == "hyprland":
        return run("hyprctl", "keyword", "monitor", f"{name},{res}@{hz},auto,{scale}")
    if desk == "niri":
        a = run("niri", "msg", "output", name, "mode", f"{res}@{hz}")
        return a or run("niri", "msg", "output", name, "scale", str(scale))
    if desk in ("i3", "openbox", "icewm"):
        return run("xrandr", "--output", name, "--mode", res, "--rate", hz)
    return 1


def displays_restore(desk):
    for name, d in (state().get("displays") or {}).items():
        if d.get("mode"):
            display_set(name, d["mode"], d.get("scale", 1.0))


# ------------------------------------------------------------------ session (runs at login)
def restart(name, *cmd):
    run("pkill", "-x", name)
    spawn(*cmd)


def session(desk):
    st = state()
    r = load_rice(st.get("rice", "grim"))
    c = r["colors"]
    displays_restore(desk)
    if desk in ("i3", "openbox", "icewm"):
        if desk != "icewm":
            run("feh", "--no-fehbg", {"fill": "--bg-fill", "fit": "--bg-max", "center": "--bg-center", "tile": "--bg-tile"}[r["wall_mode"]], r["wall"])
        names = gen_polybar_style(r, desk, bar_style_for(r, desk))
        run("pkill", "-x", "polybar")
        for n in names:
            spawn("polybar", "-c", str(GEN / "polybar.ini"), n)
        restart("picom", "picom", "--config", str(GEN / "picom.conf"))
        restart("dunst", "dunst")
        if not run("pgrep", "-x", "nm-applet") == 0:
            spawn("nm-applet")
        start_plank(r)
    elif desk in ("sway", "hyprland", "niri"):
        gen_waybar(r, desk)
        restart("waybar", "waybar", "-c", str(GEN / f"waybar-{desk}.json"), "-s", str(GEN / "waybar.css"))
        if desk != "sway":
            restart("swaybg", "swaybg", "-i", r["wall"], "-m", r["wall_mode"])
        restart("mako", "mako")
        for d in ("nwg-dock", "nwg-dock-hyprland"):
            run("pkill", "-x", d)
        if r["dock"]:
            args = ["-p", r["dock_position"], "-i", str(r["dock_size"]), "-mb", "6"] + (["-d"] if r["dock_autohide"] else [])
            spawn("nwg-dock-hyprland" if desk == "hyprland" else "nwg-dock", *args)
    elif desk == "xfce":
        xq = lambda ch, prop, typ, val: run("xfconf-query", "-c", ch, "-p", prop, "-n", "-t", typ, "-s", val)
        xq("xfwm4", "/general/easy_click", "string", "Super")
        xq("xfwm4", "/general/title_font", "string", f"{r['font']} Bold {r['font_size']}")
        xq("xsettings", "/Net/ThemeName", "string", r["gtk_theme"])
        xq("xsettings", "/Net/IconThemeName", "string", r["icon_theme"])
        sc = "xfce4-keyboard-shortcuts"
        xq(sc, "/xfwm4/custom/<Super>q", "string", "close_window_key")
        xq(sc, "/xfwm4/custom/<Super>t", "string", "maximize_window_key")
        xq(sc, "/commands/custom/<Super>space", "string", "grim-apps")
        xq(sc, "/commands/custom/<Super>Return", "string", "grim-term")
        xq(sc, "/commands/custom/Print", "string", "grim-shot")
        xq(sc, "/commands/custom/<Super>F1", "string", "grim-settings")
        try:
            props = subprocess.run(["xfconf-query", "-c", "xfce4-desktop", "-l"], capture_output=True, text=True).stdout.split()
        except Exception:
            props = []
        imgs = [p for p in props if p.endswith("/last-image")]
        if not imgs:
            try:
                mons = re.findall(r"^(\S+) connected", subprocess.run(["xrandr"], capture_output=True, text=True).stdout, re.M)
            except Exception:
                mons = []
            imgs = [f"/backdrop/screen0/monitor{m}/workspace0/last-image" for m in mons] or ["/backdrop/screen0/monitor0/workspace0/last-image"]
        for p in imgs:
            xq("xfce4-desktop", p, "string", r["wall"])
            xq("xfce4-desktop", p.replace("last-image", "image-style"), "int", {"fill": "5", "fit": "4", "center": "1", "tile": "2"}[r["wall_mode"]])
        bg = [int(c["bg2"][i:i + 2], 16) / 255 for i in (1, 3, 5)]
        run("xfconf-query", "-c", "xfce4-panel", "-p", "/panels/panel-1/background-style", "-n", "-t", "uint", "-s", "1")
        run("xfconf-query", "-c", "xfce4-panel", "-p", "/panels/panel-1/background-rgba", "-n",
            "-t", "double", "-s", f"{bg[0]:.3f}", "-t", "double", "-s", f"{bg[1]:.3f}",
            "-t", "double", "-s", f"{bg[2]:.3f}", "-t", "double", "-s", "1.0")
        start_plank(r)
    elif desk == "gnome":
        g = lambda schema, key, val: run("gsettings", "set", schema, key, val)
        g("org.gnome.desktop.wm.keybindings", "close", "['<Super>q']")
        g("org.gnome.desktop.wm.keybindings", "toggle-maximized", "['<Super>t']")
        g("org.gnome.desktop.wm.keybindings", "switch-input-source", "[]")
        g("org.gnome.desktop.wm.keybindings", "switch-input-source-backward", "[]")
        g("org.gnome.shell.keybindings", "toggle-application-view", "['<Super>space']")
        g("org.gnome.desktop.wm.preferences", "mouse-button-modifier", "'<Super>'")
        g("org.gnome.desktop.wm.preferences", "resize-with-right-button", "true")
        g("org.gnome.desktop.interface", "color-scheme", "'prefer-dark'" if r.get("dark", True) else "'default'")
        g("org.gnome.desktop.interface", "accent-color", f"'{r['gnome_accent']}'")
        g("org.gnome.desktop.interface", "icon-theme", f"'{r['icon_theme']}'")
        g("org.gnome.desktop.interface", "monospace-font-name", f"'{r['font']} {r['font_size']}'")
        g("org.gnome.desktop.background", "picture-uri", f"'file://{r['wall']}'")
        g("org.gnome.desktop.background", "picture-uri-dark", f"'file://{r['wall']}'")
        g("org.gnome.desktop.background", "picture-options", "'%s'" % {"fill": "zoom", "fit": "scaled", "center": "centered", "tile": "wallpaper"}[r["wall_mode"]])
        ext = "dash-to-panel@jderose9.github.com"
        run("gnome-extensions", "enable" if r["dock"] else "disable", ext)
    elif desk == "kde":
        run("plasma-apply-colorscheme", r["kde_scheme"])
        run("plasma-apply-wallpaperimage", r["wall"])
        run("qdbus6", "org.kde.KWin", "/KWin", "reconfigure")


def reload(desk):
    if desk == "i3":
        run("i3-msg", "restart")
    elif desk == "sway":
        run("swaymsg", "reload")
    elif desk == "hyprland":
        run("hyprctl", "reload")
        session("hyprland")
    elif desk == "niri":
        session("niri")          # niri reloads its config file by itself
    elif desk == "openbox":
        run("openbox", "--reconfigure"); session("openbox")
    elif desk == "icewm":
        run("icesh", "restart"); session("icewm")
    elif desk in ("xfce", "gnome", "kde"):
        session(desk)


# ------------------------------------------------------------------ commands
def cmd_apply(rid, desks, do_reload=True):
    r = load_rice(rid)
    save_state(rice=rid)
    gen_common(r)
    gen_picom(r)
    for d in desks:
        GENERATORS[d](r)
        if d in ("i3", "openbox", "icewm"):
            gen_polybar_style(r, d, bar_style_for(r, d))
        if d in ("sway", "hyprland", "niri"):
            gen_waybar(r, d)
    cur = running()
    if do_reload and cur in desks:
        reload(cur)
    print(f"Applied '{r['name']}' to: {', '.join(DESKTOPS[d][1] for d in desks) or 'nothing'}")


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__); return
    cmd, args = argv[0], argv[1:]
    if cmd == "list":
        cur = state().get("rice", "grim")
        for r in all_rices():
            print(f"{'*' if r['id'] == cur else ' '} {r['id']:<12} {r['name']:<12} {r['description']}")
    elif cmd == "current":
        print(state().get("rice", "grim"))
    elif cmd == "desktops":
        cur = running()
        for d in installed():
            print(f"{'*' if d == cur else ' '} {d:<9} {DESKTOPS[d][1]}")
    elif cmd == "apply":
        if not args:
            sys.exit("usage: grim-rice apply <id> [--desktop D | --all] [--no-reload]")
        rid = args[0]
        if "--desktop" in args:
            desks = [args[args.index("--desktop") + 1]]
        elif "--all" in args:
            desks = installed()
        else:
            desks = [running()] if running() else installed()
        cmd_apply(rid, [d for d in desks if d], "--no-reload" not in args)
    elif cmd == "dock" and args and args[0] in ("on", "off"):
        save_state(dock=args[0] == "on")
        cmd_apply(state().get("rice", "grim"), [d for d in [running()] if d] or installed())
    elif cmd == "bar" and args and args[0] in ("top", "bottom"):
        save_state(bar_position=args[0])
        cmd_apply(state().get("rice", "grim"), [d for d in [running()] if d] or installed())
    elif cmd == "session" and args:
        session(args[0])
    elif cmd == "set" and len(args) >= 2 and args[0] in SETTABLE:
        try:
            val = json.loads(args[1])
        except json.JSONDecodeError:
            val = args[1]
        save_state(**{args[0]: val})
        if "--no-apply" not in args:
            cmd_apply(state().get("rice", "grim"), [d for d in [running()] if d] or installed())
    elif cmd == "unset" and args and args[0] in SETTABLE:
        st = state(); st.pop(args[0], None)
        STATE.parent.mkdir(parents=True, exist_ok=True); STATE.write_text(json.dumps(st, indent=2))
        cmd_apply(st.get("rice", "grim"), [d for d in [running()] if d] or installed())
    elif cmd == "info":
        r = load_rice(state().get("rice", "grim"))
        r.update({"desktop": running(), "installed": installed(), "bar_styles": BAR_STYLES, "bar_modules_all": BAR_MODULES,
                  "bar_style_effective": bar_style_for(r, running() or "i3"), "state": state()})
        print(json.dumps(r, indent=2, ensure_ascii=False))
    elif cmd == "rices":
        print(json.dumps(all_rices(), ensure_ascii=False))
    elif cmd == "wallpapers":
        pics = []
        for d in (WALLS, HOME / "Pictures/Wallpapers", HOME / "Pictures"):
            if d.is_dir():
                pics += [str(p) for p in sorted(d.iterdir()) if p.suffix.lower() in (".jpg", ".jpeg", ".png", ".webp")]
        print(json.dumps(list(dict.fromkeys(pics))))
    elif cmd == "save-rice" and args:
        r = load_rice(state().get("rice", "grim"))
        rid = re.sub(r"[^a-z0-9]+", "-", args[0].lower()).strip("-") or "my-rice"
        keep = {k: r[k] for k in ("dark", "colors", "font", "font_size", "gaps", "border", "radius", "dock", "bar_position",
                                  "gtk_theme", "icon_theme", "gnome_accent", "kde_scheme") if k in r}
        keep.update({"name": args[0], "description": f"Saved from {r['name']} in Grim Settings.", "order": 50,
                     "wallpaper": r["wall"], "bar_style": r["bar_style"]})
        write(USER_RICES / f"{rid}.json", json.dumps(keep, indent=2))
        st = state(); [st.pop(k, None) for k in ("colors", "wallpaper")]; st["rice"] = rid
        STATE.write_text(json.dumps(st, indent=2))
        print(rid)
    elif cmd == "display" and args:
        if args[0] == "list":
            print(json.dumps(displays_list()))
        elif args[0] == "set" and len(args) >= 3:
            sys.exit(display_set(args[1], args[2], float(args[3]) if len(args) > 3 else 1.0))
        elif args[0] == "save" and len(args) >= 3:
            d = state().get("displays") or {}
            d[args[1]] = {"mode": args[2], "scale": float(args[3]) if len(args) > 3 else 1.0}
            save_state(displays=d)
    else:
        print(__doc__); sys.exit(1)


if __name__ == "__main__":
    main(sys.argv[1:])

# Everything here is regenerated by the build scripts (and much of it is huge)
*.iso
*.log
*.pkg.tar.zst
*.xbps
out/

# Grim OS (Arch)
arch/cache/
arch/work/
arch/kernel/arch-linux/
arch/kernel/linux-grim/*
!arch/kernel/linux-grim/PKGBUILD
!arch/kernel/linux-grim/0001-bore.patch
!arch/kernel/linux-grim/config.x86_64
# put there by build.sh
arch/profile/airootfs/usr/local/bin/grimfetch
arch/profile/airootfs/etc/grimfetch.toml
arch/profile/airootfs/opt/grimos/repo/

# Grim Void
void/cache/
void/work/
void/tools/
void/live-repo/
void/void-packages/
void/void-mklive/

# shared
shared/grimfetch/target/

# test VMs
**/vm/*.qcow2
**/vm/*.fd
**/vm/*.sock
**/vm/shots/

# Not published: artwork whose licence isn't known yet (the SVG Repo reaper and everything
# rendered from it, and the Nord Snow wallpaper). They stay on the build PC; see README.
arch/branding/reaper-icon-source.svg
arch/branding/logo.svg
arch/branding/logo.png
arch/branding/logo-v2.svg
arch/branding/logo-v2-white.svg
arch/branding/logo-v3.svg
arch/branding/limine-bg.png
arch/profile/airootfs/usr/share/grimos/logo.svg
arch/profile/airootfs/usr/share/grimos/logo.png
arch/profile/airootfs/usr/share/grimos/limine-bg.png
arch/profile/airootfs/usr/share/grimos/grub-theme/background.png
arch/profile/grub/themes/grimos/background.png
arch/profile/syslinux/splash.png
arch/profile/airootfs/usr/share/grimos/wallpapers/

